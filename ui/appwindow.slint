import { ScrollView } from "std-widgets.slint";

export struct UiMonitor {
    id: int,
    name: string,
    brand: string,
    resolution: string,
    is-primary: bool,
    ddc-supported: bool,
    brightness: int,
    brightness-max: int,
    brightness-sup: bool,
    contrast: int,
    contrast-max: int,
    contrast-sup: bool,
    sharpness: int,
    sharpness-max: int,
    sharpness-sup: bool,
    saturation: int,
    saturation-max: int,
    saturation-sup: bool,
    red-gain: int,
    green-gain: int,
    blue-gain: int,
    rgb-sup: bool,
    color-temp: int,
    color-temp-sup: bool,
    volume: int,
    volume-sup: bool,
    input-source: int,
    input-sup: bool,
}

// ============================================================================
// SLIDER DARK MATTE TITANIUM CON THUMB GLOW, TRACK COLORATA, WHEEL E FRECCE TASTIERA
// ============================================================================
component NeonSlider inherits Rectangle {
    in-out property <int> value: 50;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <color> track-color: #ff5733;
    in property <string> glow-style: "subtle";
    in property <bool> enabled: true;
    callback changed(int);

    height: 24px;
    background: transparent;

    property <float> ratio: Math.clamp(
        root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0.0,
        0.0,
        1.0
    );

    public function step-by(delta: int) {
        let nv = Math.clamp(root.value + delta, root.minimum, root.maximum);
        if (nv != root.value) {
            root.value = nv;
            root.changed(nv);
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;

        key-pressed(ev) => {
            if (ev.text == Key.LeftArrow || ev.text == Key.DownArrow) {
                root.step-by(-2);
                return accept;
            }
            if (ev.text == Key.RightArrow || ev.text == Key.UpArrow) {
                root.step-by(2);
                return accept;
            }
            reject
        }

        // Corsia di fondo scura opaca
        track-bg := Rectangle {
            y: (parent.height - self.height) / 2;
            height: 6px;
            width: 100%;
            border-radius: 3px;
            background: #3c4250;

            // Parte attiva colorata
            Rectangle {
                x: 0px;
                y: 0px;
                height: 100%;
                width: parent.width * root.ratio;
                border-radius: 3px;
                background: root.enabled ? root.track-color : #555b69;
            }
        }

        // Alone Glow attorno al cursore (opzionale in base a glow-style, 0 byte RAM extra)
        if root.enabled && root.glow-style != "none" : Rectangle {
            width: root.glow-style == "intense" ? 24px : 20px;
            height: self.width;
            border-radius: self.width / 2;
            x: (parent.width - 16px) * root.ratio + 8px - self.width / 2;
            y: (parent.height - self.height) / 2;
            background: root.track-color.with-alpha(root.glow-style == "intense" ? 0.35 : 0.20);
        }

        // Thumb circolare con anello scuro interno come nel mockup
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            x: (parent.width - self.width) * root.ratio;
            y: (parent.height - self.height) / 2;
            background: root.enabled ? root.track-color : #6c7382;
            border-width: 2.5px;
            border-color: #21252e;
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;

            function update-from-mouse(mx: length) {
                if (root.width > 0px) {
                    let r = Math.clamp(mx / root.width, 0.0, 1.0);
                    let nv = Math.round(root.minimum + r * (root.maximum - root.minimum));
                    if (nv != root.value) {
                        root.value = nv;
                        root.changed(nv);
                    }
                }
            }

            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    fs.focus();
                    self.update-from-mouse(self.mouse-x);
                }
            }

            moved => {
                if (self.enabled && self.pressed) {
                    self.update-from-mouse(self.mouse-x);
                }
            }

            scroll-event(ev) => {
                if (root.enabled) {
                    fs.focus();
                    let d = ev.delta-y != 0px
                        ? (ev.delta-y > 0px ? 2 : -2)
                        : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
                    if (d != 0) {
                        root.step-by(d);
                    }
                }
                accept
            }
        }
    }
}

// ============================================================================
// GAUGE CIRCOLARE AD ARCO APERTO IN BASSO (260°) — ALTA DEFINIZIONE & ZERO OVERHEAD
// ============================================================================
component ArcGauge inherits Rectangle {
    in property <int> percentage: 75;
    in property <string> label: "Brightness";
    in property <color> accent: #ff5733;
    in property <string> glow-style: "subtle";
    callback adjusted(int);

    width: 124px;
    height: 124px;
    background: transparent;

    ta-gauge := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        scroll-event(ev) => {
            let d = ev.delta-y != 0px
                ? (ev.delta-y > 0px ? 2 : -2)
                : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
            if (d != 0) {
                let nv = Math.clamp(root.percentage + d, 0, 100);
                root.adjusted(nv);
            }
            accept
        }
    }

    // Sfondo interno circolare satinato scuro
    Rectangle {
        width: 86px;
        height: 86px;
        border-radius: 43px;
        background: #171b23;
        border-width: 1px;
        border-color: #262c38;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // Traccia scura e arco di avanzamento a 120 segmenti sovrapposti ad altissima definizione (sweep 260°, raggio 46px)
    for step[idx] in 120 : Rectangle {
        property <angle> ang: -220deg + idx * 2.1848deg;
        property <length> rad: 46px;
        property <bool> active: (idx * 100 / 119) <= root.percentage;

        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        x: 62px + Math.cos(self.ang) * self.rad - 3.5px;
        y: 62px + Math.sin(self.ang) * self.rad - 3.5px;
        background: self.active ? root.accent : #282d38;
    }

    // Testo centrale percentuale + dicitura nitida come nel mockup
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: "\{root.percentage}%";
            color: #ffffff;
            font-size: 26px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: #9da5b4;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

// ============================================================================
// STAT CARD COMPATTE DEL QUARTETTO CENTRALE (Brightness, Contrast, Sharpness, Saturation)
// ============================================================================
component TitaniumStatCard inherits Rectangle {
    in property <string> title: "Brightness:";
    in-out property <int> value: 75;
    in property <int> maximum: 100;
    in property <bool> supported: true;
    in property <color> accent: #ff5733;
    in property <string> glow-style: "subtle";
    in property <bool> compact: false;
    callback changed(int);

    height: root.compact ? 112px : 128px;
    border-radius: 10px;
    background: #21252e;
    border-width: 1px;
    border-color: #2d323e;

    ta-card := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.supported;
        scroll-event(ev) => {
            if (root.supported) {
                let d = ev.delta-y != 0px
                    ? (ev.delta-y > 0px ? 2 : -2)
                    : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
                if (d != 0) {
                    let nv = Math.clamp(root.value + d, 0, root.maximum);
                    if (nv != root.value) {
                        root.value = nv;
                        root.changed(nv);
                    }
                }
            }
            accept
        }
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: root.compact ? 12px : 14px;
        padding-bottom: root.compact ? 10px : 12px;
        alignment: space-between;

        Text {
            text: root.title;
            color: #c5cbd6;
            font-size: 13px;
            font-weight: 500;
        }

        Text {
            text: "\{Math.round(root.value * 100 / Math.max(1, root.maximum))}%";
            color: #ffffff;
            font-size: root.compact ? 28px : 33px;
            font-weight: 700;
        }

        NeonSlider {
            value <=> root.value;
            minimum: 0;
            maximum: root.maximum;
            track-color: root.accent;
            glow-style: root.glow-style;
            enabled: root.supported;
            changed(v) => { root.changed(v); }
        }
    }
}

// ============================================================================
// SWITCH TOGGLE TITANIUM PER LE IMPOSTAZIONI
// ============================================================================
component TitaniumToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <color> accent: #ff5733;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? root.accent : #363b47;
    border-width: 1px;
    border-color: root.checked ? root.accent : #454b59;

    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        background: #ffffff;
        animate x { duration: 120ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ============================================================================
// PULSANTE CHIP TITANIUM
// ============================================================================
component TitaniumChip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> accent: #ff5733;
    in property <string> glow-style: "subtle";
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: root.active ? root.accent.with-alpha(0.18) : #282d38;
    border-width: root.active ? (root.glow-style == "intense" ? 2px : 1.5px) : 1px;
    border-color: root.active ? root.accent : #363c4a;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? #ffffff : #b8bfcc;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// FINESTRA PRINCIPALE: DARK MATTE TITANIUM (BORDERLESS CON TOP BAR INTEGRATA)
// ============================================================================
export component AppWindow inherits Window {
    title: "Monitor Manager";
    no-frame: true;
    preferred-width: 980px;
    preferred-height: 600px;
    min-width: 860px;
    min-height: 540px;
    background: transparent;

    // --- Proprietà di Stato Principali ---
    in-out property <[UiMonitor]> monitors: [
        {
            id: 0,
            name: "ASUS TUF Gaming VG27A",
            brand: "ASUS",
            resolution: "2560×1440 | 165Hz",
            is-primary: true,
            ddc-supported: true,
            brightness: 75,
            brightness-max: 100,
            brightness-sup: true,
            contrast: 50,
            contrast-max: 100,
            contrast-sup: true,
            sharpness: 60,
            sharpness-max: 100,
            sharpness-sup: true,
            saturation: 50,
            saturation-max: 100,
            saturation-sup: true,
            red-gain: 50,
            green-gain: 50,
            blue-gain: 50,
            rgb-sup: true,
            color-temp: 5,
            color-temp-sup: true,
            volume: 40,
            volume-sup: true,
            input-source: 15,
            input-sup: true,
        }
    ];
    in-out property <int> selected-monitor-index: 0;
    // "home" | "dashboard" | "profiles" | "reorder" | "settings"
    in-out property <string> active-view: "home";

    // Proprietà reattive dirette per slider ultra-reattivi (zero delay, zero freeze)
    in-out property <int> current-brightness: 75;
    in-out property <int> current-contrast: 50;
    in-out property <int> current-sharpness: 60;
    in-out property <int> current-saturation: 50;
    in-out property <int> current-red-gain: 50;
    in-out property <int> current-green-gain: 50;
    in-out property <int> current-blue-gain: 50;
    in-out property <int> current-volume: 40;

    public function sync-current-values() {
        if (root.monitors.length > 0) {
            let idx = Math.clamp(root.selected-monitor-index, 0, root.monitors.length - 1);
            let m = root.monitors[idx];
            root.current-brightness = m.brightness;
            root.current-contrast = m.contrast;
            root.current-sharpness = m.sharpness;
            root.current-saturation = m.saturation;
            root.current-red-gain = m.red-gain;
            root.current-green-gain = m.green-gain;
            root.current-blue-gain = m.blue-gain;
            root.current-volume = m.volume;
        }
    }

    // --- Impostazioni Personalizzazione (Zero RAM Overhead) ---
    // Lingua: "it" | "en"
    in-out property <string> lang: "it";
    // Palette Accento: "coral" | "cyan" | "emerald" | "violet" | "amber"
    in-out property <string> accent-palette: "coral";
    // Stile Glow Bordi: "none" | "subtle" | "intense"
    in-out property <string> glow-style: "subtle";
    // Densità Layout: "standard" | "compact"
    in-out property <string> layout-density: "standard";
    // Vera Trasparenza Windows Acrylic (DWM) sulla sidebar
    in-out property <bool> acrylic-enabled: true;

    // Impostazioni Funzionali & Sistema
    in-out property <string> layout-mode: "single";
    in-out property <bool> sync-monitors: false;
    in-out property <bool> hide-unsupported: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> window-maximized: false;

    // Stato Auto-Updater GitHub
    in-out property <string> app-version: "1.10";
    in-out property <string> update-status-text: "Monitor Manager v1.10 (Dark Matte Titanium & Acrylic)";
    in-out property <bool> update-available: false;
    in-out property <string> latest-version: "1.10";

    // --- Callbacks verso Rust ---
    callback set-vcp(int /* monitor_id */, int /* vcp_code */, int /* value */);
    callback apply-preset(int /* monitor_id */, int /* lum */, int /* con */);
    callback reset-rgb(int /* monitor_id */);
    callback rescan-monitors();
    callback save-settings();
    callback check-updates();
    callback install-update();
    callback quit-app();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback move-monitor(int /* index */, int /* direction: -1 up, 1 down */);
    callback toggle-acrylic(bool);

    // --- Palette Colori Reattive ---
    property <bool> is-en: root.lang == "en";
    property <bool> is-compact: root.layout-density == "compact";

    property <color> accent-main:
        root.accent-palette == "cyan" ? #00d8ff :
        root.accent-palette == "emerald" ? #00e676 :
        root.accent-palette == "violet" ? #b356ff :
        root.accent-palette == "amber" ? #ffab00 :
        #f05a46; // Coral Neon (default dal mockup)

    property <color> accent-soft:
        root.accent-palette == "cyan" ? #00d8ff33 :
        root.accent-palette == "emerald" ? #00e67633 :
        root.accent-palette == "violet" ? #b356ff33 :
        root.accent-palette == "amber" ? #ffab0033 :
        #f05a4638;

    property <UiMonitor> current-monitor: root.monitors.length > 0
        ? root.monitors[Math.clamp(root.selected-monitor-index, 0, root.monitors.length - 1)]
        : {
            id: 0, name: "Monitor", brand: "Generic", resolution: "1920×1080",
            is-primary: true, ddc-supported: false,
            brightness: 50, brightness-max: 100, brightness-sup: true,
            contrast: 50, contrast-max: 100, contrast-sup: true,
            sharpness: 50, sharpness-max: 100, sharpness-sup: true,
            saturation: 50, saturation-max: 100, saturation-sup: true,
            red-gain: 50, green-gain: 50, blue-gain: 50, rgb-sup: true,
            color-temp: 5, color-temp-sup: true,
            volume: 50, volume-sup: true,
            input-source: 15, input-sup: true,
        };

    property <string> active-input-label:
        root.current-monitor.input-source == 15 ? "DisplayPort 1" :
        root.current-monitor.input-source == 16 ? "DisplayPort 2" :
        root.current-monitor.input-source == 17 ? "HDMI 1" :
        root.current-monitor.input-source == 18 ? "HDMI 2" :
        root.current-monitor.input-source == 27 ? "USB-C" : "DisplayPort 1";

    // Contenitore principale con angoli arrotondati standard Windows
    main-container := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.window-maximized ? 0px : 12px;
        clip: true;
        background: transparent;
        border-width: root.window-maximized ? 0px : 1px;
        border-color: #2c313d;

        HorizontalLayout {
            spacing: 0px;

            // ================================================================
            // 1. SIDEBAR SINISTRA (Stile Dark Matte Slate & Acrylic dal Mockup)
            // ================================================================
            Rectangle {
                width: 248px;
                background: root.acrylic-enabled ? #181d2673 : #232731;

                // Sfumatura calda ambrata diffusa nel punto luce del mockup (Dark Smoke Bokeh)
                if root.glow-style != "none" : Rectangle {
                    x: 60px;
                    y: parent.height - 220px;
                    width: 188px;
                    height: 220px;
                    background: @linear-gradient(135deg, transparent 0%, root.acrylic-enabled ? #ff5c4735 : root.accent-soft 100%);
                }

                // Bordo verticale destro di separazione
                Rectangle {
                    x: parent.width - 1px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: #2e3340;
                }

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;

                    // Header App: Icona Monitor + "Monitor Manager" (trascinabile con WindowMoveArea nativo Slint)
                    Rectangle {
                        height: 34px;
                        background: transparent;

                        WindowMoveArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Icona monitor vettoriale fedele al mockup (schermo + piedistallo)
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                background: transparent;

                                // Schermo
                                Rectangle {
                                    x: 1px;
                                    y: 1px;
                                    width: 20px;
                                    height: 14px;
                                    border-radius: 3px;
                                    border-width: 1.5px;
                                    border-color: #4aa3df;
                                    background: #151b26;

                                    // Display interno attivo
                                    Rectangle {
                                        x: 2px;
                                        y: 2px;
                                        width: 13px;
                                        height: 7px;
                                        border-radius: 1px;
                                        background: @linear-gradient(135deg, #3ea8ff 0%, #1565c0 100%);
                                    }
                                }

                                // Gambo piedistallo
                                Rectangle {
                                    x: 9.5px;
                                    y: 15px;
                                    width: 3px;
                                    height: 3px;
                                    background: #4aa3df;
                                }

                                // Base piedistallo
                                Rectangle {
                                    x: 5px;
                                    y: 18px;
                                    width: 12px;
                                    height: 2px;
                                    border-radius: 1px;
                                    background: #4aa3df;
                                }
                            }

                            // Titolo tipografico raffinato con micro-badge DDC/CI
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: "Monitor Manager";
                                    color: #ffffff;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #333a48;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: "DDC/CI";
                                            color: #4aa3df;
                                            font-size: 9px;
                                            font-weight: 700;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Spazio prima del menu
                    Rectangle { height: 6px; background: transparent; }

                    // --- VOCE HOME IN CIMA (Panoramica Rapida a Blocchi) ---
                    Rectangle {
                        height: 40px;
                        border-radius: 9px;
                        background: root.active-view == "home" ? #2f3441 : transparent;
                        border-width: root.active-view == "home" ? 1px : 0px;
                        border-color: root.active-view == "home" ? root.accent-main.with-alpha(0.5) : transparent;

                        if root.active-view == "home" : Rectangle {
                            x: 0px;
                            y: 10px;
                            width: 3px;
                            height: 20px;
                            border-radius: 1.5px;
                            background: root.accent-main;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "⌂";
                                color: root.active-view == "home" ? root.accent-main : #9da5b4;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.is-en ? "Home · Overview" : "Home · Panoramica";
                                color: root.active-view == "home" ? #ffffff : #c3c9d5;
                                font-size: 13px;
                                font-weight: root.active-view == "home" ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active-view = "home"; }
                        }
                    }

                    // Intestazione sezione monitor
                    Rectangle {
                        height: 18px;
                        background: transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            Text {
                                text: root.is-en ? "DISPLAYS" : "MONITOR COLLEGATI";
                                color: #6f788a;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // --- LISTA MONITOR HARDWARE COLLEGATI (con Accordion per Monitor Attivo) ---
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            for mon[idx] in root.monitors : mon-entry := VerticalLayout {
                                spacing: 3px;
                                property <bool> is-mon-active: idx == root.selected-monitor-index && (root.active-view == "dashboard" || root.active-view == "profiles");

                                mon-card := Rectangle {
                                    height: 44px;
                                    border-radius: 10px;
                                    background: transparent;

                                    // Alone Neon Glow esterno quando il monitor è selezionato
                                    if mon-entry.is-mon-active && root.glow-style != "none" : Rectangle {
                                        x: -2px;
                                        y: -2px;
                                        width: parent.width + 4px;
                                        height: parent.height + 4px;
                                        border-radius: 12px;
                                        background: root.accent-main.with-alpha(root.glow-style == "intense" ? 0.30 : 0.16);
                                        border-width: 1px;
                                        border-color: root.accent-main.with-alpha(0.45);
                                    }

                                    // Card interna del monitor
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: 9px;
                                        background: mon-entry.is-mon-active ? #2b303c : transparent;
                                        border-width: mon-entry.is-mon-active ? (root.glow-style == "intense" ? 2px : 1.5px) : 0px;
                                        border-color: root.accent-main;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                Text {
                                                    text: "▭";
                                                    color: mon-entry.is-mon-active ? #ffffff : #9da5b4;
                                                    font-size: 14px;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: mon.name;
                                                    color: mon-entry.is-mon-active ? #ffffff : #c3c9d5;
                                                    font-size: 12.5px;
                                                    font-weight: mon-entry.is-mon-active ? 600 : 500;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Pallino LED attivo a destra
                                            if mon-entry.is-mon-active : Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                background: root.accent-main;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected-monitor-index = idx;
                                            root.sync-current-values();
                                            if (root.active-view != "profiles") {
                                                root.active-view = "dashboard";
                                            }
                                        }
                                    }
                                }

                                // --- SOTTO-ELENCO ACCORDION (Dashboard & Profili Colore) ---
                                if mon-entry.is-mon-active : VerticalLayout {
                                    padding-left: 18px;
                                    padding-right: 4px;
                                    spacing: 4px;

                                    // Sotto-voce 1: Dashboard
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.active-view == "dashboard" ? root.accent-main.with-alpha(0.20) : #21252e;
                                        border-width: 1px;
                                        border-color: root.active-view == "dashboard" ? root.accent-main : #2d323e;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;

                                            Text {
                                                text: "↳ ⊞";
                                                color: root.active-view == "dashboard" ? root.accent-main : #9da5b4;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "Dashboard";
                                                color: root.active-view == "dashboard" ? #ffffff : #c3c9d5;
                                                font-size: 12px;
                                                font-weight: root.active-view == "dashboard" ? 600 : 500;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.active-view = "dashboard"; }
                                        }
                                    }

                                    // Sotto-voce 2: Profili Colore
                                    Rectangle {
                                        height: 32px;
                                        border-radius: 6px;
                                        background: root.active-view == "profiles" ? root.accent-main.with-alpha(0.20) : #21252e;
                                        border-width: 1px;
                                        border-color: root.active-view == "profiles" ? root.accent-main : #2d323e;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            alignment: start;

                                            Text {
                                                text: "↳ ◐";
                                                color: root.active-view == "profiles" ? root.accent-main : #9da5b4;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: root.is-en ? "Color Profiles" : "Profili Colore";
                                                color: root.active-view == "profiles" ? #ffffff : #c3c9d5;
                                                font-size: 12px;
                                                font-weight: root.active-view == "profiles" ? 600 : 500;
                                                vertical-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.active-view = "profiles"; }
                                        }
                                    }
                                }
                            }

                            // Separatore sottile
                            Rectangle {
                                height: 12px;
                                background: transparent;
                                Rectangle {
                                    y: 6px;
                                    height: 1px;
                                    width: 100%;
                                    background: #323744;
                                }
                            }

                            // Voce rapida: Ordina Monitor (Gestione Ordine)
                            Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: root.active-view == "reorder" ? #2f3441 : transparent;
                                border-width: root.active-view == "reorder" ? 1px : 0px;
                                border-color: root.active-view == "reorder" ? root.accent-main : transparent;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    alignment: start;

                                    Text {
                                        text: "⇅";
                                        color: root.active-view == "reorder" ? root.accent-main : #9da5b4;
                                        font-size: 15px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.is-en ? "Reorder Displays" : "Ordina Monitor";
                                        color: root.active-view == "reorder" ? #ffffff : #c3c9d5;
                                        font-size: 12.5px;
                                        font-weight: root.active-view == "reorder" ? 600 : 500;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.active-view = "reorder"; }
                                }
                            }
                        }
                    }

                    // Separatore sopra il menu inferiore
                    Rectangle {
                        height: 1px;
                        background: #323744;
                    }

                    // --- MENU INFERIORE (Solo Impostazioni) ---
                    Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: root.active-view == "settings" ? #313643 : transparent;

                        if root.active-view == "settings" : Rectangle {
                            x: 0px;
                            y: 10px;
                            width: 3px;
                            height: 20px;
                            border-radius: 1.5px;
                            background: root.accent-main;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;
                            Text {
                                text: "⚙";
                                color: root.active-view == "settings" ? #ffffff : #9da5b4;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.is-en ? "Settings" : "Impostazioni";
                                color: root.active-view == "settings" ? #ffffff : #c3c9d5;
                                font-size: 13px;
                                font-weight: root.active-view == "settings" ? 600 : 500;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active-view = "settings"; }
                        }
                    }
                }
            }

            // ================================================================
            // 2. AREA PRINCIPALE DESTRA (Dark Matte Canvas + Top Window Bar)
            // ================================================================
            Rectangle {
                horizontal-stretch: 1;
                background: #171a21;

                VerticalLayout {
                    spacing: 0px;

                    // --- BARRA SUPERIORE BORDERLESS CON TRASCINAMENTO NATIVO SLINT ---
                    Rectangle {
                        height: 38px;
                        background: transparent;

                        // Area di trascinamento finestra nativa Slint (zero deadlock Win32)
                        WindowMoveArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            padding-left: 22px;
                            padding-right: 14px;
                            spacing: 0px;

                            // Zona comandi rapidi header
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                HorizontalLayout {
                                    alignment: start;
                                    if root.update-available : Rectangle {
                                        height: 22px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        background: root.accent-main.with-alpha(0.22);
                                        border-width: 1px;
                                        border-color: root.accent-main;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.is-en
                                                    ? "✦ Update v\{root.latest-version} ready"
                                                    : "✦ Aggiornamento v\{root.latest-version} pronto";
                                                color: #ffffff;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.install-update(); }
                                        }
                                    }
                                }
                            }

                            // Blocco Tasti Finestra in alto a destra (Pillola con colore accento dell'app con icone definite)
                            Rectangle {
                                width: 114px;
                                height: 30px;
                                y: 4px;
                                border-radius: 7px;
                                background: root.accent-main;

                                HorizontalLayout {
                                    spacing: 0px;

                                    // Riduci a icona (trattino bianco)
                                    min-btn := Rectangle {
                                        horizontal-stretch: 1;
                                        background: min-ta.has-hover ? #00000028 : transparent;
                                        border-top-left-radius: 7px;
                                        border-bottom-left-radius: 7px;

                                        Rectangle {
                                            width: 10px;
                                            height: 2px;
                                            border-radius: 1px;
                                            background: #ffffff;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        min-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.minimize-window(); }
                                        }
                                    }

                                    // Ingrandisci / Ripristina (quadratino bianco)
                                    max-btn := Rectangle {
                                        horizontal-stretch: 1;
                                        background: max-ta.has-hover ? #00000028 : transparent;

                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-width: 1.6px;
                                            border-color: #ffffff;
                                            border-radius: 1.5px;
                                            background: transparent;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        max-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-maximize-window(); }
                                        }
                                    }

                                    // Chiudi / System Tray (X bianca vettoriale con hover rosso scuro)
                                    cls-btn := Rectangle {
                                        horizontal-stretch: 1;
                                        background: cls-ta.has-hover ? #c5221f : transparent;
                                        border-top-right-radius: 7px;
                                        border-bottom-right-radius: 7px;

                                        Path {
                                            width: 10px;
                                            height: 10px;
                                            stroke: #ffffff;
                                            stroke-width: 1.8px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            MoveTo { x: 0; y: 0; }
                                            LineTo { x: 10; y: 10; }
                                            MoveTo { x: 10; y: 0; }
                                            LineTo { x: 0; y: 10; }
                                        }

                                        cls-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.close-window(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- CONTENUTO PRINCIPALE SCORREVOLE ---
                    ScrollView {
                        vertical-stretch: 1;

                        HorizontalLayout {
                            alignment: center;

                            VerticalLayout {
                                max-width: 1040px;
                                padding-left: 22px;
                                padding-right: 22px;
                                padding-top: root.is-compact ? 8px : 14px;
                                padding-bottom: 22px;
                                spacing: root.is-compact ? 12px : 16px;
                                alignment: start;

                            // ========================================================
                            // VISTA 0: HOME — PANORAMICA RAPIDA MONITOR AFFIANCATI
                            // ========================================================
                            if root.active-view == "home" : VerticalLayout {
                                spacing: 16px;

                                // Header Sezione Home
                                Rectangle {
                                    height: 58px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: root.is-en ? "Displays Overview · Quick Controls" : "Panoramica Display · Controlli Rapidi";
                                                color: #ffffff;
                                                font-size: 16px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: root.is-en
                                                    ? "Adjust brightness & contrast instantly across your connected screens."
                                                    : "Regola al volo luminosità e contrasto di tutti i display collegati.";
                                                color: #9da5b4;
                                                font-size: 11px;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 10px;
                                            TitaniumChip {
                                                text: root.sync-monitors ? (root.is-en ? "✓ Sync Enabled" : "✓ Sync Attivo") : (root.is-en ? "⇄ Sync All" : "⇄ Sincronizza Tutti");
                                                active: root.sync-monitors;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.sync-monitors = !root.sync-monitors;
                                                    root.save-settings();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Blocchi affiancati dei monitor (disposizione orizzontale reattiva)
                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: start;

                                    for mon[m-idx] in root.monitors : Rectangle {
                                        min-width: 330px;
                                        horizontal-stretch: 1;
                                        border-radius: 12px;
                                        background: #21252e;
                                        border-width: 1px;
                                        border-color: #2d323e;

                                        VerticalLayout {
                                            padding: 18px;
                                            spacing: 14px;

                                            // Intestazione Blocco Monitor
                                            HorizontalLayout {
                                                alignment: space-between;
                                                VerticalLayout {
                                                    spacing: 4px;
                                                    alignment: start;
                                                    Text {
                                                        text: mon.name;
                                                        color: #ffffff;
                                                        font-size: 16px;
                                                        font-weight: 700;
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        alignment: start;
                                                        Rectangle {
                                                            width: 7px;
                                                            height: 7px;
                                                            y: (parent.height - self.height) / 2;
                                                            border-radius: 3.5px;
                                                            background: mon.ddc-supported ? #39d353 : #f59e0b;
                                                        }
                                                        Text {
                                                            text: mon.ddc-supported ? "DDC/CI Attivo" : "Modalità Software";
                                                            color: mon.ddc-supported ? #39d353 : #f59e0b;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                        }
                                                    }
                                                }

                                                // Pill Risoluzione / Info
                                                Rectangle {
                                                    height: 24px;
                                                    border-radius: 6px;
                                                    background: #1b1e27;
                                                    border-width: 1px;
                                                    border-color: #2c3240;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        Text {
                                                            text: mon.resolution;
                                                            color: #9da5b4;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Slider Rapidi Luminosità & Contrasto
                                            VerticalLayout {
                                                spacing: 10px;

                                                // Luminosità
                                                Rectangle {
                                                    background: transparent;
                                                    TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        scroll-event(ev) => {
                                                            let d = ev.delta-y != 0px
                                                                ? (ev.delta-y > 0px ? 2 : -2)
                                                                : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
                                                            if (d != 0) {
                                                                let nv = Math.clamp(mon.brightness + d, 0, mon.brightness-max);
                                                                if (nv != mon.brightness) {
                                                                    root.set-vcp(mon.id, 16, nv);
                                                                }
                                                            }
                                                            accept
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 4px;
                                                        HorizontalLayout {
                                                            alignment: space-between;
                                                            Text {
                                                                text: root.is-en ? "Brightness" : "Luminosità";
                                                                color: #c5cbd6;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                            }
                                                            Text {
                                                                text: "\{mon.brightness}%";
                                                                color: root.accent-main;
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                            }
                                                        }
                                                        NeonSlider {
                                                            value: mon.brightness;
                                                            minimum: 0;
                                                            maximum: mon.brightness-max;
                                                            track-color: root.accent-main;
                                                            glow-style: root.glow-style;
                                                            changed(v) => { root.set-vcp(mon.id, 16, v); }
                                                        }
                                                    }
                                                }

                                                // Contrasto
                                                Rectangle {
                                                    background: transparent;
                                                    TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        scroll-event(ev) => {
                                                            let d = ev.delta-y != 0px
                                                                ? (ev.delta-y > 0px ? 2 : -2)
                                                                : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
                                                            if (d != 0) {
                                                                let nv = Math.clamp(mon.contrast + d, 0, mon.contrast-max);
                                                                if (nv != mon.contrast) {
                                                                    root.set-vcp(mon.id, 18, nv);
                                                                }
                                                            }
                                                            accept
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 4px;
                                                        HorizontalLayout {
                                                            alignment: space-between;
                                                            Text {
                                                                text: root.is-en ? "Contrast" : "Contrasto";
                                                                color: #c5cbd6;
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                            }
                                                            Text {
                                                                text: "\{mon.contrast}%";
                                                                color: root.accent-main;
                                                                font-size: 12px;
                                                                font-weight: 700;
                                                            }
                                                        }
                                                        NeonSlider {
                                                            value: mon.contrast;
                                                            minimum: 0;
                                                            maximum: mon.contrast-max;
                                                            track-color: root.accent-main;
                                                            glow-style: root.glow-style;
                                                            changed(v) => { root.set-vcp(mon.id, 18, v); }
                                                        }
                                                    }
                                                }
                                            }

                                            // Pulsante Azione: Apri Dettagli Monitor
                                            Rectangle {
                                                height: 36px;
                                                border-radius: 8px;
                                                background: #2a303d;
                                                border-width: 1px;
                                                border-color: #384050;

                                                HorizontalLayout {
                                                    alignment: center;
                                                    spacing: 6px;
                                                    Text {
                                                        text: root.is-en ? "Monitor Details & RGB ➔" : "Dettagli Monitor & RGB ➔";
                                                        color: #ffffff;
                                                        font-size: 12px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.selected-monitor-index = m-idx;
                                                        root.sync-current-values();
                                                        root.active-view = "dashboard";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 1: DASHBOARD PRINCIPALE (Come nel Mockup!)
                            // ========================================================
                            if root.active-view == "dashboard" : VerticalLayout {
                                spacing: root.is-compact ? 12px : 16px;

                                // 1. HERO HEADER CARD (Monitor Name, DDC/CI Active Badge, Spec Chip, 270° Arc Gauge)
                                Rectangle {
                                    height: root.is-compact ? 132px : 148px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    HorizontalLayout {
                                        padding-left: 24px;
                                        padding-right: 28px;
                                        padding-top: 16px;
                                        padding-bottom: 16px;
                                        alignment: space-between;

                                        // Colonna Sinistra: Nome Monitor + Badge DDC/CI + Risoluzione/Hz/Input
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 10px;

                                            Text {
                                                text: root.current-monitor.name;
                                                color: #f3f5f9;
                                                font-size: root.is-compact ? 22px : 26px;
                                                font-weight: 700;
                                            }

                                            // Pill "DDC/CI Active" con pallino verde
                                            HorizontalLayout {
                                                alignment: start;
                                                Rectangle {
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: #2a2f3b;
                                                    border-width: 1px;
                                                    border-color: #363c4a;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        spacing: 8px;
                                                        alignment: center;

                                                        Rectangle {
                                                            width: 8px;
                                                            height: 8px;
                                                            y: (parent.height - self.height) / 2;
                                                            border-radius: 4px;
                                                            background: root.current-monitor.ddc-supported ? #39d353 : #f59e0b;
                                                        }

                                                        Text {
                                                            text: root.current-monitor.ddc-supported
                                                                ? (root.is-en ? "DDC/CI Active" : "DDC/CI Attivo")
                                                                : (root.is-en ? "Software Mode" : "Modalità Software");
                                                            color: #dcdfe6;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Pill Risoluzione | Refresh | Input
                                            HorizontalLayout {
                                                alignment: start;
                                                Rectangle {
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: #282c37;
                                                    border-width: 1px;
                                                    border-color: #343947;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        alignment: center;
                                                        Text {
                                                            text: "\{root.current-monitor.resolution} | \{root.active-input-label}";
                                                            color: #c5cbd6;
                                                            font-size: 12.5px;
                                                            font-weight: 500;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Colonna Destra: Circular Arc Gauge 270°
                                        VerticalLayout {
                                            alignment: center;
                                            ArcGauge {
                                                percentage: Math.round(root.current-brightness * 100 / Math.max(1, root.current-monitor.brightness-max));
                                                label: root.is-en ? "Brightness" : "Luminosità";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                adjusted(v) => {
                                                    root.set-vcp(root.current-monitor.id, 16, Math.round(v * root.current-monitor.brightness-max / 100));
                                                }
                                            }
                                        }
                                    }
                                }

                                // 2. QUARTETTO STAT CARDS (Brightness, Contrast, Sharpness, Saturation)
                                HorizontalLayout {
                                    spacing: root.is-compact ? 10px : 14px;

                                    TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Brightness:" : "Luminosità:";
                                        value <=> root.current-brightness;
                                        maximum: root.current-monitor.brightness-max;
                                        supported: root.current-monitor.brightness-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 16, v); }
                                    }

                                    TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Contrast:" : "Contrasto:";
                                        value <=> root.current-contrast;
                                        maximum: root.current-monitor.contrast-max;
                                        supported: root.current-monitor.contrast-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 18, v); }
                                    }

                                    TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Sharpness:" : "Nitidezza:";
                                        value <=> root.current-sharpness;
                                        maximum: root.current-monitor.sharpness-max;
                                        supported: root.current-monitor.sharpness-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 135, v); }
                                    }

                                    TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Saturation:" : "Saturazione:";
                                        value <=> root.current-saturation;
                                        maximum: root.current-monitor.saturation-max;
                                        supported: root.current-monitor.saturation-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 138, v); }
                                    }
                                }

                                // 3. CARD RGB GAIN (Red, Green, Blue)
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding-left: 22px;
                                        padding-right: 22px;
                                        padding-top: root.is-compact ? 14px : 18px;
                                        padding-bottom: root.is-compact ? 14px : 18px;
                                        spacing: root.is-compact ? 10px : 14px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en ? "RGB Gain" : "Guadagno RGB";
                                                color: #e9edf5;
                                                font-size: 14px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }

                                            // Pulsante rapido Reset RGB 50%
                                            Rectangle {
                                                height: 24px;
                                                border-radius: 5px;
                                                background: #2a2f3b;
                                                border-width: 1px;
                                                border-color: #363c4a;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    Text {
                                                        text: root.is-en ? "Reset 50%" : "Ripristina 50%";
                                                        color: #b8bfcc;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.current-red-gain = 50;
                                                        root.current-green-gain = 50;
                                                        root.current-blue-gain = 50;
                                                        root.reset-rgb(root.current-monitor.id);
                                                    }
                                                }
                                            }
                                        }

                                        // Canale RED
                                        HorizontalLayout {
                                            spacing: 16px;
                                            Text {
                                                width: 68px;
                                                text: root.is-en ? "Red" : "Rosso";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            NeonSlider {
                                                horizontal-stretch: 1;
                                                value <=> root.current-red-gain;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: #e85642;
                                                glow-style: root.glow-style;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 22, v); }
                                            }
                                            Text {
                                                width: 38px;
                                                text: "\{root.current-red-gain}%";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Canale GREEN
                                        HorizontalLayout {
                                            spacing: 16px;
                                            Text {
                                                width: 68px;
                                                text: root.is-en ? "Green" : "Verde";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            NeonSlider {
                                                horizontal-stretch: 1;
                                                value <=> root.current-green-gain;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: #46b966;
                                                glow-style: root.glow-style;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 24, v); }
                                            }
                                            Text {
                                                width: 38px;
                                                text: "\{root.current-green-gain}%";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Canale BLUE
                                        HorizontalLayout {
                                            spacing: 16px;
                                            Text {
                                                width: 68px;
                                                text: root.is-en ? "Blue" : "Blu";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            NeonSlider {
                                                horizontal-stretch: 1;
                                                value <=> root.current-blue-gain;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: #4a7ee5;
                                                glow-style: root.glow-style;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 26, v); }
                                            }
                                            Text {
                                                width: 38px;
                                                text: "\{root.current-blue-gain}%";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 2: COLOR PROFILES, TEMPERATURA COLORE, AUDIO & INPUT
                            // ========================================================
                            if root.active-view == "profiles" : VerticalLayout {
                                spacing: 14px;

                                // Header Monitor Selezionato
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        Text {
                                            text: root.is-en
                                                ? "Color Profiles & Quick Presets — \{root.current-monitor.name}"
                                                : "Profili Colore & Preset Rapidi — \{root.current-monitor.name}";
                                            color: #f3f5f9;
                                            font-size: 16px;
                                            font-weight: 700;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "☀ Gaming Vivid (90/75)" : "☀ Gaming Vivace (90/75)";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.current-brightness = 90;
                                                    root.current-contrast = 75;
                                                    root.apply-preset(root.current-monitor.id, 90, 75);
                                                }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "◐ Standard sRGB (75/50)" : "◐ Standard sRGB (75/50)";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.current-brightness = 75;
                                                    root.current-contrast = 50;
                                                    root.apply-preset(root.current-monitor.id, 75, 50);
                                                }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "☾ Eye Care Night (35/45)" : "☾ Comfort Notturno (35/45)";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.current-brightness = 35;
                                                    root.current-contrast = 45;
                                                    root.apply-preset(root.current-monitor.id, 35, 45);
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.is-en ? "Color Temperature (VCP 0x14)" : "Temperatura Colore (VCP 0x14)";
                                            color: #c5cbd6;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "5000K Warm" : "5000K Caldo";
                                                active: root.current-monitor.color-temp == 4;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 20, 4); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "6500K Standard";
                                                active: root.current-monitor.color-temp == 5;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 20, 5); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "9300K Cool" : "9300K Freddo";
                                                active: root.current-monitor.color-temp == 8;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 20, 8); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "User RGB" : "Utente RGB";
                                                active: root.current-monitor.color-temp == 11;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 20, 11); }
                                            }
                                        }
                                    }
                                }

                                // Card Audio Volume & Video Input Source
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en ? "Speaker Volume (VCP 0x62)" : "Volume Altoparlanti (VCP 0x62)";
                                                color: #e9edf5;
                                                font-size: 14px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "\{root.current-volume}%";
                                                color: root.accent-main;
                                                font-size: 14px;
                                                font-weight: 700;
                                            }
                                        }

                                        NeonSlider {
                                            value <=> root.current-volume;
                                            minimum: 0;
                                            maximum: 100;
                                            track-color: root.accent-main;
                                            glow-style: root.glow-style;
                                            changed(v) => { root.set-vcp(root.current-monitor.id, 98, v); }
                                        }

                                        Text {
                                            text: root.is-en ? "Video Input Source (VCP 0x60)" : "Sorgente Input Video (VCP 0x60)";
                                            color: #c5cbd6;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "DisplayPort 1";
                                                active: root.current-monitor.input-source == 15;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 96, 15); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "DisplayPort 2";
                                                active: root.current-monitor.input-source == 16;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 96, 16); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "HDMI 1";
                                                active: root.current-monitor.input-source == 17;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 96, 17); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "HDMI 2";
                                                active: root.current-monitor.input-source == 18;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 96, 18); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "USB-C";
                                                active: root.current-monitor.input-source == 27;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.set-vcp(root.current-monitor.id, 96, 27); }
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 3: ORDINA MONITOR (Gestione Ordine & Priorità)
                            // ========================================================
                            if root.active-view == "reorder" : VerticalLayout {
                                spacing: 14px;

                                Rectangle {
                                    height: 58px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: root.is-en ? "Displays Order · Priority Setup" : "Ordinamento & Priorità Monitor";
                                                color: #ffffff;
                                                font-size: 16px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: root.is-en
                                                    ? "Change display priority. The sequence here updates the sidebar and Home immediately."
                                                    : "Modifica l'ordine dei monitor. L'elenco qui definito gestisce la sequenza nella barra laterale e nella Home.";
                                                color: #9da5b4;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 10px;

                                    for mon[m-idx] in root.monitors : Rectangle {
                                        height: 68px;
                                        border-radius: 12px;
                                        background: #21252e;
                                        border-width: 1px;
                                        border-color: #2d323e;

                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 20px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 16px;
                                                alignment: start;

                                                // Badge posizione numerica (#1, #2...)
                                                Rectangle {
                                                    width: 34px;
                                                    height: 34px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 8px;
                                                    background: root.accent-main.with-alpha(0.20);
                                                    border-width: 1px;
                                                    border-color: root.accent-main;

                                                    Text {
                                                        text: "#\{m-idx + 1}";
                                                        color: root.accent-main;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 4px;

                                                    Text {
                                                        text: mon.name;
                                                        color: #ffffff;
                                                        font-size: 15px;
                                                        font-weight: 700;
                                                    }
                                                    Text {
                                                        text: mon.ddc-supported
                                                            ? "\{mon.brand} · \{mon.resolution} · DDC/CI Attivo"
                                                            : "\{mon.brand} · \{mon.resolution} · Software Mode";
                                                        color: #9da5b4;
                                                        font-size: 11px;
                                                    }
                                                }
                                            }

                                            // Pulsanti Sposta Su / Sposta Giù
                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: center;

                                                // Tasto Sposta Su
                                                Rectangle {
                                                    width: 110px;
                                                    height: 34px;
                                                    border-radius: 7px;
                                                    background: m-idx > 0 ? #2a303d : #1c2028;
                                                    border-width: 1px;
                                                    border-color: m-idx > 0 ? #384052 : #252a35;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        spacing: 6px;
                                                        Text {
                                                            text: "▲";
                                                            color: m-idx > 0 ? root.accent-main : #555c6d;
                                                            font-size: 10px;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.is-en ? "Move Up" : "Sposta Su";
                                                            color: m-idx > 0 ? #ffffff : #555c6d;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    TouchArea {
                                                        enabled: m-idx > 0;
                                                        mouse-cursor: m-idx > 0 ? pointer : default;
                                                        clicked => { root.move-monitor(m-idx, -1); }
                                                    }
                                                }

                                                // Tasto Sposta Giù
                                                Rectangle {
                                                    width: 115px;
                                                    height: 34px;
                                                    border-radius: 7px;
                                                    background: m-idx < root.monitors.length - 1 ? #2a303d : #1c2028;
                                                    border-width: 1px;
                                                    border-color: m-idx < root.monitors.length - 1 ? #384052 : #252a35;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        spacing: 6px;
                                                        Text {
                                                            text: "▼";
                                                            color: m-idx < root.monitors.length - 1 ? root.accent-main : #555c6d;
                                                            font-size: 10px;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.is-en ? "Move Down" : "Sposta Giù";
                                                            color: m-idx < root.monitors.length - 1 ? #ffffff : #555c6d;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    TouchArea {
                                                        enabled: m-idx < root.monitors.length - 1;
                                                        mouse-cursor: m-idx < root.monitors.length - 1 ? pointer : default;
                                                        clicked => { root.move-monitor(m-idx, 1); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 4: IMPOSTAZIONI (Organizzate in 4 Card Tematiche)
                            // ========================================================
                            if root.active-view == "settings" : VerticalLayout {
                                spacing: 14px;

                                // CARD 1: SISTEMA & COMPORTAMENTO
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        Text {
                                            text: root.is-en ? "💻 System & Behavior" : "💻 Sistema & Comportamento";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Start automatically with Windows (minimized to System Tray)"
                                                    : "Avvia automaticamente all'avvio di Windows (in background)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.start-with-windows;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Minimize to System Tray on close (X) (~2-6 MB RAM in Gaming)"
                                                    : "Riduci nella System Tray alla chiusura (X) (~2-6 MB RAM)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.close-to-tray;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Synchronize adjustments across all connected displays"
                                                    : "Sincronizza le modifiche su tutti i monitor collegati (Sync All)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.sync-monitors;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }
                                    }
                                }

                                // CARD 2: ASPETTO & PERSONALIZZAZIONE CYBERPUNK
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        Text {
                                            text: root.is-en ? "🎨 Cyberpunk Style & Accent Theme" : "🎨 Aspetto & Personalizzazione Cyberpunk";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                        }

                                        // Palette Colore d'Accento
                                        Text {
                                            text: root.is-en ? "Accent Color Palette" : "Palette Colore d'Accento";
                                            color: #9da5b4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "● Coral Neon";
                                                active: root.accent-palette == "coral";
                                                accent: #f05a46;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "coral"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "● Cyber Cyan";
                                                active: root.accent-palette == "cyan";
                                                accent: #00d8ff;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "cyan"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "● Emerald";
                                                active: root.accent-palette == "emerald";
                                                accent: #00e676;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "emerald"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "● Electric Violet";
                                                active: root.accent-palette == "violet";
                                                accent: #b356ff;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "violet"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: "● Amber Gold";
                                                active: root.accent-palette == "amber";
                                                accent: #ffab00;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "amber"; root.save-settings(); }
                                            }
                                        }

                                        // Intensità Bagliore Neon
                                        Text {
                                            text: root.is-en ? "Active Border & Slider Glow Intensity" : "Intensità Bagliore Neon (Bordi & Cursori)";
                                            color: #9da5b4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Minimal / Off" : "Disattivato / Minimal";
                                                active: root.glow-style == "none";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.glow-style = "none"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Subtle (Default)" : "Sottile (Predefinito)";
                                                active: root.glow-style == "subtle";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.glow-style = "subtle"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Intense Gaming Neon" : "Intenso (Gaming Neon)";
                                                active: root.glow-style == "intense";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.glow-style = "intense"; root.save-settings(); }
                                            }
                                        }

                                        // Densità Layout
                                        Text {
                                            text: root.is-en ? "Layout Density" : "Densità Spaziatura Layout";
                                            color: #9da5b4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Comfort (Standard)" : "Comodo (Standard)";
                                                active: root.layout-density == "standard";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.layout-density = "standard"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Compact" : "Compatto";
                                                active: root.layout-density == "compact";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.layout-density = "compact"; root.save-settings(); }
                                            }
                                        }

                                        // Separatore
                                        Rectangle { height: 1px; background: #2e3442; }

                                        // Toggle Trasparenza Windows Acrylic (DWM)
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: root.is-en ? "Windows Acrylic Transparency (DWM)" : "Trasparenza Windows Acrylic (DWM)";
                                                    color: #ffffff;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.is-en
                                                        ? "Real-time desktop frosted glass blur behind the sidebar"
                                                        : "Vera sfocatura vetro satinato del desktop dietro la sidebar";
                                                    color: #8c95a6;
                                                    font-size: 11px;
                                                }
                                            }
                                            TitaniumToggle {
                                                checked <=> root.acrylic-enabled;
                                                toggled(v) => { root.toggle-acrylic(v); }
                                            }
                                        }
                                    }
                                }

                                // CARD 3: HARDWARE DDC/CI & LINGUA
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        Text {
                                            text: root.is-en ? "🌐 Hardware DDC/CI & Language" : "🌐 Hardware DDC/CI & Lingua";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en ? "Interface Language" : "Lingua dell'Interfaccia";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                TitaniumChip {
                                                    text: "🇮🇹 Italiano";
                                                    active: root.lang == "it";
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.lang = "it"; root.save-settings(); }
                                                }
                                                TitaniumChip {
                                                    text: "🇬🇧 English";
                                                    active: root.lang == "en";
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.lang = "en"; root.save-settings(); }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Hide controls unsupported by DDC/CI hardware"
                                                    : "Nascondi controlli non supportati dall'hardware";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.hide-unsupported;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Rescan display bus and re-detect hardware monitors"
                                                    : "Esegui una nuova scansione dei monitor collegati";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumChip {
                                                text: root.is-en ? "↻ Rescan Hardware Now" : "↻ Rileva Monitor Ora";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.rescan-monitors(); }
                                            }
                                        }
                                    }
                                }

                                // CARD 4: SOFTWARE & AGGIORNAMENTI GITHUB
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        Text {
                                            text: root.is-en ? "🚀 Software Updates & Application Info" : "🚀 Aggiornamenti Software & Informazioni";
                                            color: #ffffff;
                                            font-size: 15px;
                                            font-weight: 700;
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Check for GitHub updates automatically on startup"
                                                    : "Controlla aggiornamenti GitHub automaticamente all'avvio";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.auto-check-updates;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: #2e3340;
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;
                                                Text {
                                                    text: root.update-status-text;
                                                    color: #e9edf5;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Ultra-Lightweight Rust Engine · Slint Native UI";
                                                    color: #9da5b4;
                                                    font-size: 11px;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: center;

                                                TitaniumChip {
                                                    text: root.is-en ? "Check Updates" : "Verifica Aggiornamenti";
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.check-updates(); }
                                                }
                                                if root.update-available : TitaniumChip {
                                                    text: root.is-en ? "Update Now" : "Aggiorna Ora";
                                                    active: true;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.install-update(); }
                                                }
                                                TitaniumChip {
                                                    text: root.is-en ? "Quit App" : "Esci Completamente";
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.quit-app(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}

// ============================================================================
// FINESTRA INSTALLER SETUP v1.09 (DARK MATTE TITANIUM & ACRYLIC)
// ============================================================================
export component SetupWindow inherits Window {
    title: "Installazione Monitor Manager v1.09";
    preferred-width: 520px;
    preferred-height: 410px;
    background: transparent;

    in-out property <bool> opt-desktop: true;
    in-out property <bool> opt-start-menu: true;
    in-out property <bool> opt-autostart: false;
    in-out property <bool> opt-launch: true;
    in-out property <bool> installing: false;
    in-out property <bool> installed: false;
    in-out property <string> status-text: "Pronto per installare Monitor Manager v1.09 (Dark Matte Titanium & Acrylic)";
    in-out property <string> install-path: "";

    callback start-install();
    callback finish-setup();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        clip: true;
        background: #171a21;
        border-width: 1px;
        border-color: #2c313d;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

        Rectangle {
            height: 76px;
            border-radius: 12px;
            background: #21252e;
            border-width: 1.5px;
            border-color: #f05a46;

            HorizontalLayout {
                padding: 18px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "Monitor Manager v1.09";
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Dark Matte Titanium & Acrylic · Motore Nativo Slint (~2-8 MB RAM in Tray)";
                        color: #c5cbd6;
                        font-size: 12px;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 12px;
            background: #21252e;
            border-width: 1px;
            border-color: #2d323e;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Crea collegamento sul Desktop";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-desktop; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Crea collegamento nel Menu Start";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-start-menu; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Avvia automaticamente con Windows (in System Tray)";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-autostart; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Avvia Monitor Manager al termine";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-launch; }
                }

                Text {
                    text: root.status-text;
                    color: root.installed ? #39d353 : #9da5b4;
                    font-size: 12px;
                    font-weight: 600;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            if !root.installed : Rectangle {
                width: 190px;
                height: 40px;
                border-radius: 8px;
                background: root.installing ? #454b59 : #f05a46;
                Text {
                    text: root.installing ? "Installazione..." : "Installa v1.09 Ora";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    enabled: !root.installing;
                    mouse-cursor: pointer;
                    clicked => { root.start-install(); }
                }
            }
            if root.installed : Rectangle {
                width: 190px;
                height: 40px;
                border-radius: 8px;
                background: #39d353;
                Text {
                    text: "Completa e Avvia";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.finish-setup(); }
                }
            }
        }
    }
    }
}
