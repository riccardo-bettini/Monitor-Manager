export struct UiMonitor {
    id: int,
    name: string,
    brand: string,
    resolution: string,
    is-primary: bool,
    ddc-supported: bool,
    brightness: int,
    brightness-max: int,
    brightness-sup: bool,
    contrast: int,
    contrast-max: int,
    contrast-sup: bool,
    sharpness: int,
    sharpness-max: int,
    sharpness-sup: bool,
    saturation: int,
    saturation-max: int,
    saturation-sup: bool,
    red-gain: int,
    green-gain: int,
    blue-gain: int,
    rgb-sup: bool,
    color-temp: int,
    color-temp-sup: bool,
    volume: int,
    volume-sup: bool,
    input-source: int,
    input-sup: bool,
}

component NativeSlider inherits Rectangle {
    in-out property <int> value: 50;
    in property <int> maximum: 100;
    in property <color> accent-color: #df4b3b;
    in property <color> track-bg: #ffffff24;
    callback edited(int);

    height: 24px;
    background: transparent;

    property <float> ratio: Math.clamp(root.value / Math.max(1, root.maximum), 0.0, 1.0);

    // Track di fondo
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8px;
        width: parent.width;
        border-radius: 4px;
        background: root.track-bg;
        border-width: 1px;
        border-color: #ffffff22;

        // Riempimento attivo
        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            width: parent.width * root.ratio;
            border-radius: 4px;
            background: root.accent-color;
        }
    }

    // Thumb circolare con riflesso
    thumb := Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        x: Math.clamp((parent.width - self.width) * root.ratio, 0px, parent.width - self.width);
        y: (parent.height - self.height) / 2;
        background: #ffffff;
        border-width: 2.5px;
        border-color: root.accent-color;
        animate width, height { duration: 150ms; easing: ease-out; }
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;

        function update-from-x(mx: length) {
            let r = Math.clamp(mx / root.width, 0.0, 1.0);
            let nv = Math.round(r * root.maximum);
            if (nv != root.value) {
                root.value = nv;
                root.edited(nv);
            }
        }

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                update-from-x(self.mouse-x);
            }
        }

        moved => {
            if (self.pressed) {
                update-from-x(self.mouse-x);
            }
        }
    }
}

component PillChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <color> accent: #df4b3b;
    in property <color> text-col: #ffffff;
    in property <color> surface-col: #ffffff18;
    callback clicked();

    height: 30px;
    border-radius: 15px;
    background: root.active ? root.accent : root.surface-col;
    border-width: 1px;
    border-color: root.active ? #ffffff88 : #ffffff26;
    animate background { duration: 180ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? #ffffff : root.text-col;
            font-size: 11.5px;
            font-weight: root.active ? 700 : 600;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component IosToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <color> accent: #df4b3b;
    callback toggled(bool);

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? root.accent : #00000044;
    border-width: 1px;
    border-color: root.checked ? #ffffff66 : #ffffff30;
    animate background { duration: 200ms; }

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        y: 3px;
        x: root.checked ? 23px : 3px;
        background: #ffffff;
        animate x { duration: 200ms; easing: cubic-bezier(0.22, 1.38, 0.36, 1); }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component StatGlassCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> icon-glyph;
    in-out property <int> value: 50;
    in property <int> maximum: 100;
    in property <bool> is-accent: false;
    in property <color> accent-color: #df4b3b;
    in property <color> card-bg: #2a201ecc;
    in property <color> text-primary: #ffffff;
    in property <color> text-secondary: #ffffffb0;
    callback changed(int);

    height: 146px;
    border-radius: 20px;
    background: root.is-accent ? @linear-gradient(135deg, root.accent-color 0%, root.accent-color.darker(0.35) 100%) : root.card-bg;
    border-width: 1px;
    border-color: root.is-accent ? #ffffff66 : #ffffff28;

    VerticalLayout {
        padding: 15px;
        spacing: 6px;
        alignment: space-between;

        // Top row: icon + badge
        HorizontalLayout {
            alignment: space-between;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: root.is-accent ? #ffffff28 : #ffffff18;
                border-width: 1px;
                border-color: #ffffff30;
                Text {
                    text: root.icon-glyph;
                    color: root.is-accent ? #ffffff : root.accent-color;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: root.is-accent ? #ffffff : #10b98128;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    Text {
                        text: root.badge-text;
                        color: root.is-accent ? root.accent-color : #34d399;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Middle: big number + title
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 1px;
                Text {
                    text: root.maximum == 100 ? "\{root.value}%" : "\{root.value} / \{root.maximum}";
                    color: root.is-accent ? #ffffff : root.text-primary;
                    font-size: 25px;
                    font-weight: 800;
                }
                Text {
                    text: root.title;
                    color: root.is-accent ? #ffffff : root.text-primary;
                    font-size: 12.5px;
                    font-weight: 700;
                }
                Text {
                    text: root.subtitle;
                    color: root.is-accent ? #ffffffcc : root.text-secondary;
                    font-size: 10.5px;
                }
            }
        }

        // Slider integrato
        NativeSlider {
            value <=> root.value;
            maximum: root.maximum;
            accent-color: root.is-accent ? #ffffff : root.accent-color;
            track-bg: root.is-accent ? #00000038 : #00000040;
            edited(v) => { root.changed(v); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Monitor Manager";
    preferred-width: 1150px;
    preferred-height: 760px;
    min-width: 840px;
    min-height: 580px;

    // Stato e modelli collegati al backend Rust
    in-out property <[UiMonitor]> monitors: [];
    in-out property <int> selected-monitor-index: 0;
    in-out property <string> active-view: "dashboard"; // "dashboard" | "multi" | "color" | "io" | "settings"
    in-out property <string> active-settings-cat: "theme"; // "theme" | "display" | "system" | "updates"
    in-out property <bool> sidebar-collapsed: false;

    // Impostazioni
    in-out property <string> theme-pref: "system"; // "light" | "dark" | "system"
    in-out property <bool> dark-mode: true;
    in-out property <string> accent-palette: "coral"; // "coral" | "cyan" | "emerald" | "purple" | "amber"
    in-out property <string> layout-mode: "single";
    in-out property <bool> sync-monitors: false;
    in-out property <bool> hide-unsupported: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> auto-check-updates: true;

    // Stato aggiornamenti
    in-out property <string> app-version: "1.02";
    in-out property <bool> update-available: false;
    in-out property <string> latest-version: "1.02";
    in-out property <string> update-status-text: "Canale ufficiale GitHub Releases attivo";
    in-out property <string> greeting-title: "Buon pomeriggio, Monitor Studio";
    in-out property <string> greeting-subtitle: "Motore Rust + Slint Nativo Ultra-Leggero";
    in-out property <string> today-day-num: "11";
    in-out property <string> today-day-name: "Mercoledì";
    in-out property <string> today-month-year: "Novembre 2026";

    // Callback verso Rust
    callback select-monitor(int);
    callback set-vcp(int, int, int); // (monitor_id, vcp_code, value)
    callback apply-preset(int, int, int); // (monitor_id, lum, con)
    callback reset-rgb(int); // (monitor_id)
    callback rescan-monitors();
    callback save-settings();
    callback check-updates();
    callback install-update();
    callback quit-app();

    // Palette e colori calcolati in tempo reale
    property <color> accent-main:
        root.accent-palette == "cyan" ? #0ea5e9 :
        root.accent-palette == "emerald" ? #10b981 :
        root.accent-palette == "purple" ? #a855f7 :
        root.accent-palette == "amber" ? #f59e0b : #df4b3b;

    property <color> accent-dark:
        root.accent-palette == "cyan" ? #3b82f6 :
        root.accent-palette == "emerald" ? #059669 :
        root.accent-palette == "purple" ? #c026d3 :
        root.accent-palette == "amber" ? #d97706 : #b83227;

    property <color> win-bg-1: root.dark-mode ? #171110 : #efe5df;
    property <color> win-bg-2: root.dark-mode ? #241917 : #e2d1c7;
    property <color> sidebar-surface: root.dark-mode ? #382521d8 : #7a4b41e6;
    property <color> board-surface: root.dark-mode ? #291d1ad4 : #f7efeae6;
    property <color> card-surface: root.dark-mode ? #3a2b27cc : #ffffffd9;
    property <color> card-surface-elevated: root.dark-mode ? #473530d9 : #ffffffef;
    property <color> text-main: root.dark-mode ? #ffffff : #221614;
    property <color> text-dim: root.dark-mode ? #f5e6e0b8 : #4e3530c4;

    property <UiMonitor> current-monitor: root.monitors.length > 0 ? root.monitors[Math.clamp(root.selected-monitor-index, 0, root.monitors.length - 1)] : {
        id: 0,
        name: "Nessun monitor rilevato",
        brand: "Display",
        resolution: "1920 × 1080",
        is-primary: true,
        ddc-supported: false,
        brightness: 50, brightness-max: 100, brightness-sup: true,
        contrast: 50, contrast-max: 100, contrast-sup: true,
        sharpness: 50, sharpness-max: 100, sharpness-sup: true,
        saturation: 50, saturation-max: 100, saturation-sup: true,
        red-gain: 50, green-gain: 50, blue-gain: 50, rgb-sup: true,
        color-temp: 5, color-temp-sup: true,
        volume: 50, volume-sup: true,
        input-source: 15, input-sup: true,
    };

    background: root.win-bg-1;

    // Sfondo con gradiente atmosferico e bagliori morbidi
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(135deg, root.win-bg-1 0%, root.win-bg-2 55%, root.win-bg-1 100%);

        // Bagliore atmosferico superiore sinistro
        Rectangle {
            x: -80px;
            y: -80px;
            width: 420px;
            height: 420px;
            border-radius: 210px;
            background: @radial-gradient(circle, root.accent-main.with-alpha(0.22) 0%, transparent 70%);
        }

        // Bagliore atmosferico inferiore destro
        Rectangle {
            x: parent.width - 360px;
            y: parent.height - 340px;
            width: 440px;
            height: 440px;
            border-radius: 220px;
            background: @radial-gradient(circle, root.accent-dark.with-alpha(0.20) 0%, transparent 70%);
        }
    }

    // Layout principale a 2 Macro-Blocchi Fluttuanti
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;

        // ====================================================================
        // 1. SIDEBAR LATERALE FLUTTUANTE A CAPSULA
        // ====================================================================
        Rectangle {
            width: root.sidebar-collapsed ? 68px : 232px;
            border-radius: 26px;
            background: @linear-gradient(180deg, root.sidebar-surface 0%, root.sidebar-surface.darker(0.25) 100%);
            border-width: 1px;
            border-color: #ffffff38;
            animate width { duration: 220ms; easing: cubic-bezier(0.22, 1.38, 0.36, 1); }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header Logo + Bottone Comprimi
                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 11px;
                            background: #ffffff;
                            Text {
                                text: "MM";
                                color: root.accent-main;
                                font-size: 13px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if !root.sidebar-collapsed : VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Monitor Manager";
                                color: #ffffff;
                                font-size: 13.5px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Native Glass • v\{root.app-version}";
                                color: #ffffffb0;
                                font-size: 10.5px;
                            }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: #ffffff;
                        Text {
                            text: root.sidebar-collapsed ? ">" : "<";
                            color: #1c1412;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                        }
                    }
                }

                // Sezione MAIN
                if !root.sidebar-collapsed : Text {
                    text: "MAIN";
                    color: #ffffff80;
                    font-size: 9.5px;
                    font-weight: 700;
                }

                // Pulsanti Navigazione Principale
                for nav-item[idx] in [
                    { id: "dashboard", label: "Dashboard", icon: "⌂" },
                    { id: "multi", label: "Tutti Affiancati", icon: "⊞" },
                    { id: "color", label: "Colori & RGB", icon: "◉" },
                    { id: "io", label: "Audio & Sorgenti", icon: "♫" },
                ] : Rectangle {
                    height: 38px;
                    border-radius: 12px;
                    background: root.active-view == nav-item.id ? #ffffff : transparent;
                    animate background { duration: 150ms; }

                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 10px;
                        alignment: root.sidebar-collapsed ? center : start;
                        Text {
                            text: nav-item.icon;
                            color: root.active-view == nav-item.id ? #1c1412 : #ffffffd0;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if !root.sidebar-collapsed : Text {
                            text: nav-item.label;
                            color: root.active-view == nav-item.id ? #1c1412 : #ffffffdd;
                            font-size: 12.5px;
                            font-weight: root.active-view == nav-item.id ? 700 : 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-view = nav-item.id; }
                    }
                }

                // Sezione MONITOR COLLEGATI
                if !root.sidebar-collapsed : Text {
                    text: "MONITOR COLLEGATI";
                    color: #ffffff80;
                    font-size: 9.5px;
                    font-weight: 700;
                }

                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        for mon[m-idx] in root.monitors : mon-row := Rectangle {
                            height: 40px;
                            border-radius: 12px;
                            property <bool> is-sel: m-idx == root.selected-monitor-index && root.active-view != "multi" && root.active-view != "settings";
                            background: self.is-sel ? #ffffff26 : transparent;
                            border-width: self.is-sel ? 1px : 0px;
                            border-color: #ffffff55;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: root.sidebar-collapsed ? center : space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "▢";
                                        color: root.accent-main;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    if !root.sidebar-collapsed : Text {
                                        text: mon.name;
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: mon-row.is-sel ? 700 : 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                if !root.sidebar-collapsed : Rectangle {
                                    height: 20px;
                                    border-radius: 10px;
                                    background: root.accent-main;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "\{mon.brightness}%";
                                            color: #ffffff;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-monitor-index = m-idx;
                                    if (root.active-view == "settings" || root.active-view == "multi") {
                                        root.active-view = "dashboard";
                                    }
                                    root.select-monitor(m-idx);
                                }
                            }
                        }
                    }
                }

                // Sezione SYSTEM
                if !root.sidebar-collapsed : Text {
                    text: "SYSTEM";
                    color: #ffffff80;
                    font-size: 9.5px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 38px;
                    border-radius: 12px;
                    background: root.active-view == "settings" ? #ffffff : transparent;
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 10px;
                        alignment: root.sidebar-collapsed ? center : space-between;
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "⚙";
                                color: root.active-view == "settings" ? #1c1412 : #ffffffd0;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            if !root.sidebar-collapsed : Text {
                                text: "Impostazioni & Temi";
                                color: root.active-view == "settings" ? #1c1412 : #ffffffdd;
                                font-size: 12.5px;
                                font-weight: root.active-view == "settings" ? 700 : 600;
                                vertical-alignment: center;
                            }
                        }
                        if !root.sidebar-collapsed && root.update-available : Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: root.accent-main;
                            Text {
                                text: "!";
                                color: #ffffff;
                                font-size: 10px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-view = "settings"; }
                    }
                }

                // Footer Sidebar
                Rectangle {
                    height: 1px;
                    background: #ffffff22;
                }

                HorizontalLayout {
                    spacing: 9px;
                    alignment: root.sidebar-collapsed ? center : start;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: @linear-gradient(135deg, root.accent-main 0%, root.accent-dark 100%);
                        border-width: 1px;
                        border-color: #ffffff88;
                        Text {
                            text: "⚡";
                            color: #ffffff;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if !root.sidebar-collapsed : VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Ultra-Light Engine";
                            color: #ffffff;
                            font-size: 11.5px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Zero WebView • Nativo";
                            color: #ffffff99;
                            font-size: 10px;
                        }
                    }
                }
            }
        }

        // ====================================================================
        // 2. PANNELLO PRINCIPALE CONTENUTI (GLASS MAIN BOARD)
        // ====================================================================
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 28px;
            background: root.board-surface;
            border-width: 1px;
            border-color: #ffffff30;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Top Header Bar
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: root.active-view == "settings" ? "Impostazioni & Personalizzazione" :
                                  root.active-view == "multi" ? "Controllo Multi-Monitor Affiancato" :
                                  "\{root.greeting-title} — \{root.current-monitor.name}";
                            color: root.text-main;
                            font-size: 21px;
                            font-weight: 800;
                        }
                        Text {
                            text: "\{root.today-day-name} \{root.today-day-num} \{root.today-month-year} • \{root.monitors.length} monitor DDC/CI attivi";
                            color: root.text-dim;
                            font-size: 12px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        // Pulsante Rileva Monitor
                        Rectangle {
                            height: 34px;
                            border-radius: 17px;
                            background: root.card-surface-elevated;
                            border-width: 1px;
                            border-color: #ffffff40;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                Text {
                                    text: "↻ Rileva Monitor";
                                    color: root.text-main;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.rescan-monitors(); }
                            }
                        }

                        // Pulsante Sync Tutti
                        Rectangle {
                            height: 34px;
                            border-radius: 17px;
                            background: root.sync-monitors ? root.accent-main : #181211e0;
                            border-width: 1px;
                            border-color: root.sync-monitors ? #ffffff88 : #ffffff30;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                Text {
                                    text: root.sync-monitors ? "✓ Sync Tutti Attivo" : "+ Sync Tutti i Monitor";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sync-monitors = !root.sync-monitors;
                                    root.save-settings();
                                }
                            }
                        }
                    }
                }

                // Banner Aggiornamento Disponibile
                if root.update-available : Rectangle {
                    height: 46px;
                    border-radius: 16px;
                    background: @linear-gradient(135deg, root.accent-main 0%, root.accent-dark 100%);
                    border-width: 1px;
                    border-color: #ffffff66;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;
                        Text {
                            text: "✦ Nuova versione v\{root.latest-version} disponibile su GitHub Releases!";
                            color: #ffffff;
                            font-size: 12.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 30px;
                            border-radius: 15px;
                            background: #ffffff;
                            y: 8px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: "Aggiorna e Riavvia ora";
                                    color: #1c1412;
                                    font-size: 11.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.install-update(); }
                            }
                        }
                    }
                }

                // Contenuto Principale Scorrevole
                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 14px;
                        alignment: start;

                        // ====================================================
                        // VISTA A: DASHBOARD / COLOR / IO
                        // ====================================================
                        if root.active-view == "dashboard" || root.active-view == "color" || root.active-view == "io" : VerticalLayout {
                            spacing: 14px;

                            // RIGA 1: HERO CARD + SIDE WIDGET (visibile in Dashboard)
                            if root.active-view == "dashboard" : HorizontalLayout {
                                spacing: 14px;

                                // HERO GLASS CARD (Stile Coral Sunset V24)
                                Rectangle {
                                    horizontal-stretch: 1.85;
                                    height: 192px;
                                    border-radius: 24px;
                                    background: @linear-gradient(135deg, root.accent-main 0%, root.accent-dark 100%);
                                    border-width: 1px;
                                    border-color: #ffffff55;

                                    HorizontalLayout {
                                        padding: 20px;
                                        spacing: 16px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            spacing: 8px;
                                            alignment: space-between;
                                            horizontal-stretch: 1;

                                            // Status pill
                                            Rectangle {
                                                height: 22px;
                                                width: 240px;
                                                border-radius: 11px;
                                                background: #ffffff28;
                                                border-width: 1px;
                                                border-color: #ffffff44;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    Text {
                                                        text: "● DDC/CI Hardware • \{root.current-monitor.brand}";
                                                        color: #ffffff;
                                                        font-size: 10.5px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            Text {
                                                text: "Il tuo \{root.current-monitor.name} è pronto";
                                                color: #ffffff;
                                                font-size: 20px;
                                                font-weight: 800;
                                                overflow: elide;
                                            }

                                            // 3 Metriche rapide
                                            HorizontalLayout {
                                                spacing: 22px;
                                                VerticalLayout {
                                                    Text { text: "\{root.current-monitor.brightness}%"; color: #ffffff; font-size: 16px; font-weight: 800; }
                                                    Text { text: "Luminosità"; color: #ffffffcc; font-size: 10.5px; }
                                                }
                                                VerticalLayout {
                                                    Text { text: "\{root.current-monitor.contrast}%"; color: #ffffff; font-size: 16px; font-weight: 800; }
                                                    Text { text: "Contrasto"; color: #ffffffcc; font-size: 10.5px; }
                                                }
                                                VerticalLayout {
                                                    Text { text: root.current-monitor.resolution; color: #ffffff; font-size: 16px; font-weight: 800; }
                                                    Text { text: "Risoluzione"; color: #ffffffcc; font-size: 10.5px; }
                                                }
                                            }

                                            // Bottoni rapidi Hero Card
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Rectangle {
                                                    height: 30px;
                                                    border-radius: 15px;
                                                    background: #ffffff;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text {
                                                            text: "Preset Brillante (75%) ↗";
                                                            color: #1c1412;
                                                            font-size: 11.5px;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.apply-preset(root.current-monitor.id, 75, 75); }
                                                    }
                                                }

                                                Rectangle {
                                                    height: 30px;
                                                    border-radius: 15px;
                                                    background: #ffffff24;
                                                    border-width: 1px;
                                                    border-color: #ffffff55;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text {
                                                            text: "+ Comfort Visivo (45%)";
                                                            color: #ffffff;
                                                            font-size: 11.5px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.apply-preset(root.current-monitor.id, 45, 70); }
                                                    }
                                                }
                                            }
                                        }

                                        // Gauge Circolare Nativo sulla destra della Hero Card
                                        Rectangle {
                                            width: 148px;
                                            height: 148px;
                                            border-radius: 74px;
                                            background: #ffffff18;
                                            border-width: 7px;
                                            border-color: #ffffffcc;

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "\{root.current-monitor.brightness}%";
                                                    color: #ffffff;
                                                    font-size: 26px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: "luminosità";
                                                    color: #ffffffcc;
                                                    font-size: 10.5px;
                                                    horizontal-alignment: center;
                                                }
                                            }

                                            // Nodo orbitale superiore
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                border-radius: 14px;
                                                x: (parent.width - self.width) / 2;
                                                y: -10px;
                                                background: #ffffff;
                                                Text {
                                                    text: "☼";
                                                    color: root.accent-main;
                                                    font-size: 12px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Nodo orbitale inferiore
                                            Rectangle {
                                                width: 34px;
                                                height: 22px;
                                                border-radius: 11px;
                                                x: (parent.width - self.width) / 2;
                                                y: parent.height - 14px;
                                                background: #ffffff;
                                                Text {
                                                    text: "VCP";
                                                    color: #1c1412;
                                                    font-size: 9.5px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // SIDE WIDGET DESTRO (Calendario + Info Hardware)
                                Rectangle {
                                    horizontal-stretch: 1.0;
                                    height: 192px;
                                    border-radius: 24px;
                                    background: root.card-surface-elevated;
                                    border-width: 1px;
                                    border-color: #ffffff44;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text {
                                                    text: root.today-day-num;
                                                    color: root.accent-main;
                                                    font-size: 32px;
                                                    font-weight: 800;
                                                    vertical-alignment: center;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: root.today-day-name;
                                                        color: root.text-main;
                                                        font-size: 13.5px;
                                                        font-weight: 700;
                                                    }
                                                    Text {
                                                        text: root.today-month-year;
                                                        color: root.text-dim;
                                                        font-size: 11px;
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                height: 24px;
                                                border-radius: 12px;
                                                background: root.accent-main.with-alpha(0.2);
                                                HorizontalLayout {
                                                    padding-left: 9px;
                                                    padding-right: 9px;
                                                    Text {
                                                        text: root.current-monitor.is-primary ? "Principale" : "Esteso";
                                                        color: root.accent-main;
                                                        font-size: 10.5px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Box Info Hardware 1
                                        Rectangle {
                                            height: 48px;
                                            border-radius: 14px;
                                            background: root.card-surface;
                                            border-width: 1px;
                                            border-color: #ffffff24;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                alignment: space-between;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Modello: \{root.current-monitor.name}";
                                                        color: root.text-main;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: "Risoluzione nativa \{root.current-monitor.resolution}";
                                                        color: root.text-dim;
                                                        font-size: 10.5px;
                                                    }
                                                }
                                                Text {
                                                    text: "EDID";
                                                    color: root.accent-main;
                                                    font-size: 10.5px;
                                                    font-weight: 800;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Box Info Hardware 2
                                        Rectangle {
                                            height: 48px;
                                            border-radius: 14px;
                                            background: root.card-surface;
                                            border-width: 1px;
                                            border-color: #ffffff24;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                alignment: space-between;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: root.current-monitor.ddc-supported ? "Bus DDC/CI Operativo" : "DDC/CI Limitato";
                                                        color: root.text-main;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                    }
                                                    Text {
                                                        text: "RGB: \{root.current-monitor.red-gain}/\{root.current-monitor.green-gain}/\{root.current-monitor.blue-gain} • Vol: \{root.current-monitor.volume}%";
                                                        color: root.text-dim;
                                                        font-size: 10.5px;
                                                    }
                                                }
                                                Text {
                                                    text: "I²C";
                                                    color: #34d399;
                                                    font-size: 10.5px;
                                                    font-weight: 800;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // RIGA 2: 4 STAT CARDS INTERATTIVE (Luminosità, Contrasto, Nitidezza, Saturazione)
                            if root.active-view == "dashboard" : HorizontalLayout {
                                spacing: 12px;

                                StatGlassCard {
                                    horizontal-stretch: 1;
                                    title: "Luminosità";
                                    subtitle: "Retroilluminazione";
                                    badge-text: "VCP 0x10";
                                    icon-glyph: "☼";
                                    value: root.current-monitor.brightness;
                                    maximum: root.current-monitor.brightness-max;
                                    accent-color: root.accent-main;
                                    card-bg: root.card-surface-elevated;
                                    text-primary: root.text-main;
                                    text-secondary: root.text-dim;
                                    changed(v) => { root.set-vcp(root.current-monitor.id, 16, v); }
                                }

                                StatGlassCard {
                                    horizontal-stretch: 1;
                                    title: "Contrasto";
                                    subtitle: "Gamma dinamica";
                                    badge-text: "VCP 0x12";
                                    icon-glyph: "◐";
                                    value: root.current-monitor.contrast;
                                    maximum: root.current-monitor.contrast-max;
                                    accent-color: root.accent-main;
                                    card-bg: root.card-surface-elevated;
                                    text-primary: root.text-main;
                                    text-secondary: root.text-dim;
                                    changed(v) => { root.set-vcp(root.current-monitor.id, 18, v); }
                                }

                                StatGlassCard {
                                    horizontal-stretch: 1;
                                    title: "Nitidezza";
                                    subtitle: "Definizione bordi";
                                    badge-text: "VCP 0x87";
                                    icon-glyph: "✦";
                                    value: root.current-monitor.sharpness;
                                    maximum: root.current-monitor.sharpness-max;
                                    is-accent: true;
                                    accent-color: root.accent-main;
                                    card-bg: root.card-surface-elevated;
                                    text-primary: root.text-main;
                                    text-secondary: root.text-dim;
                                    changed(v) => { root.set-vcp(root.current-monitor.id, 135, v); }
                                }

                                StatGlassCard {
                                    horizontal-stretch: 1;
                                    title: "Saturazione";
                                    subtitle: "Intensità colore";
                                    badge-text: "VCP 0x8A";
                                    icon-glyph: "◉";
                                    value: root.current-monitor.saturation;
                                    maximum: root.current-monitor.saturation-max;
                                    accent-color: root.accent-main;
                                    card-bg: root.card-surface-elevated;
                                    text-primary: root.text-main;
                                    text-secondary: root.text-dim;
                                    changed(v) => { root.set-vcp(root.current-monitor.id, 138, v); }
                                }
                            }

                            // RIGA 3: PANNELLI CALIBRAZIONE COLORE RGB & AUDIO/INPUT
                            HorizontalLayout {
                                spacing: 14px;

                                // Pannello Colore RGB & Temperatura
                                if root.active-view == "dashboard" || root.active-view == "color" : Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 22px;
                                    background: root.card-surface-elevated;
                                    border-width: 1px;
                                    border-color: #ffffff30;

                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "BILANCIAMENTO COLORE RGB & TEMPERATURA";
                                                color: root.text-dim;
                                                font-size: 11px;
                                                font-weight: 700;
                                            }
                                            PillChip {
                                                label: "Reset RGB 50%";
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => { root.reset-rgb(root.current-monitor.id); }
                                            }
                                        }

                                        // Guadagno Rosso
                                        VerticalLayout {
                                            spacing: 3px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "● Guadagno Rosso (R)"; color: root.text-main; font-size: 12.5px; font-weight: 600; }
                                                Text { text: "\{root.current-monitor.red-gain}%"; color: #ef4444; font-size: 12.5px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: root.current-monitor.red-gain;
                                                maximum: 100;
                                                accent-color: #ef4444;
                                                edited(v) => { root.set-vcp(root.current-monitor.id, 22, v); }
                                            }
                                        }

                                        // Guadagno Verde
                                        VerticalLayout {
                                            spacing: 3px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "● Guadagno Verde (G)"; color: root.text-main; font-size: 12.5px; font-weight: 600; }
                                                Text { text: "\{root.current-monitor.green-gain}%"; color: #10b981; font-size: 12.5px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: root.current-monitor.green-gain;
                                                maximum: 100;
                                                accent-color: #10b981;
                                                edited(v) => { root.set-vcp(root.current-monitor.id, 24, v); }
                                            }
                                        }

                                        // Guadagno Blu
                                        VerticalLayout {
                                            spacing: 3px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "● Guadagno Blu (B)"; color: root.text-main; font-size: 12.5px; font-weight: 600; }
                                                Text { text: "\{root.current-monitor.blue-gain}%"; color: #3b82f6; font-size: 12.5px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: root.current-monitor.blue-gain;
                                                maximum: 100;
                                                accent-color: #3b82f6;
                                                edited(v) => { root.set-vcp(root.current-monitor.id, 26, v); }
                                            }
                                        }

                                        // Preset Temperatura Colore
                                        Text {
                                            text: "Preset Temperatura Colore (VCP 0x14)";
                                            color: root.text-dim;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            for preset in [
                                                { label: "5000K Caldo", val: 4 },
                                                { label: "6500K sRGB", val: 5 },
                                                { label: "7500K", val: 6 },
                                                { label: "9300K Freddo", val: 8 },
                                                { label: "Utente", val: 11 },
                                            ] : PillChip {
                                                label: preset.label;
                                                active: root.current-monitor.color-temp == preset.val;
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => { root.set-vcp(root.current-monitor.id, 20, preset.val); }
                                            }
                                        }
                                    }
                                }

                                // Pannello Audio & Sorgente Input Video
                                if root.active-view == "dashboard" || root.active-view == "io" : Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 22px;
                                    background: root.card-surface-elevated;
                                    border-width: 1px;
                                    border-color: #ffffff30;

                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 12px;

                                        Text {
                                            text: "AUDIO & SORGENTI INPUT VIDEO";
                                            color: root.text-dim;
                                            font-size: 11px;
                                            font-weight: 700;
                                        }

                                        // Volume Altoparlanti
                                        VerticalLayout {
                                            spacing: 4px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "♫ Volume Altoparlanti (VCP 0x62)"; color: root.text-main; font-size: 12.5px; font-weight: 600; }
                                                Text { text: "\{root.current-monitor.volume}%"; color: root.accent-main; font-size: 12.5px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: root.current-monitor.volume;
                                                maximum: 100;
                                                accent-color: root.accent-main;
                                                edited(v) => { root.set-vcp(root.current-monitor.id, 98, v); }
                                            }
                                        }

                                        // Sorgenti Input
                                        Text {
                                            text: "Selettore Sorgente Input Video (VCP 0x60)";
                                            color: root.text-dim;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            for src in [
                                                { label: "DisplayPort 1", val: 15 },
                                                { label: "DisplayPort 2", val: 16 },
                                                { label: "HDMI 1", val: 17 },
                                                { label: "HDMI 2", val: 18 },
                                                { label: "USB-C", val: 27 },
                                            ] : PillChip {
                                                label: src.label;
                                                active: root.current-monitor.input-source == src.val;
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => { root.set-vcp(root.current-monitor.id, 96, src.val); }
                                            }
                                        }

                                        // Riepilogo memoria e performance
                                        Rectangle {
                                            height: 54px;
                                            border-radius: 14px;
                                            background: root.card-surface;
                                            border-width: 1px;
                                            border-color: #ffffff22;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                alignment: space-between;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Modalità Gaming Ultra-Light Attiva";
                                                        color: root.text-main;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                    }
                                                    Text {
                                                        text: "Zero processi browser • Sospensione GPU in System Tray";
                                                        color: root.text-dim;
                                                        font-size: 10.5px;
                                                    }
                                                }
                                                Text {
                                                    text: "~8 MB";
                                                    color: #34d399;
                                                    font-size: 12px;
                                                    font-weight: 800;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ====================================================
                        // VISTA B: TUTTI I MONITOR AFFIANCATI (Multi-Monitor)
                        // ====================================================
                        if root.active-view == "multi" : VerticalLayout {
                            spacing: 14px;
                            for m[idx] in root.monitors : Rectangle {
                                border-radius: 22px;
                                background: root.card-surface-elevated;
                                border-width: 1px;
                                border-color: #ffffff35;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 10px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "\{m.name} (\{m.brand}) — \{m.resolution}";
                                            color: root.text-main;
                                            font-size: 15px;
                                            font-weight: 800;
                                        }
                                        Text {
                                            text: m.ddc-supported ? "● DDC/CI Attivo" : "○ DDC Standard";
                                            color: #34d399;
                                            font-size: 11.5px;
                                            font-weight: 700;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Luminosità"; color: root.text-main; font-size: 12px; font-weight: 600; }
                                                Text { text: "\{m.brightness}%"; color: root.accent-main; font-size: 12px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: m.brightness;
                                                maximum: m.brightness-max;
                                                accent-color: root.accent-main;
                                                edited(v) => { root.set-vcp(m.id, 16, v); }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Contrasto"; color: root.text-main; font-size: 12px; font-weight: 600; }
                                                Text { text: "\{m.contrast}%"; color: root.accent-main; font-size: 12px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: m.contrast;
                                                maximum: m.contrast-max;
                                                accent-color: root.accent-main;
                                                edited(v) => { root.set-vcp(m.id, 18, v); }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Nitidezza"; color: root.text-main; font-size: 12px; font-weight: 600; }
                                                Text { text: "\{m.sharpness}"; color: root.accent-main; font-size: 12px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: m.sharpness;
                                                maximum: m.sharpness-max;
                                                accent-color: root.accent-main;
                                                edited(v) => { root.set-vcp(m.id, 135, v); }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Volume"; color: root.text-main; font-size: 12px; font-weight: 600; }
                                                Text { text: "\{m.volume}%"; color: root.accent-main; font-size: 12px; font-weight: 700; }
                                            }
                                            NativeSlider {
                                                value: m.volume;
                                                maximum: 100;
                                                accent-color: root.accent-main;
                                                edited(v) => { root.set-vcp(m.id, 98, v); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ====================================================
                        // VISTA C: IMPOSTAZIONI INTEGRATE & CATEGORIZZATE
                        // ====================================================
                        if root.active-view == "settings" : VerticalLayout {
                            spacing: 14px;

                            // Barra delle 4 Categorie Impostazioni
                            HorizontalLayout {
                                spacing: 8px;
                                for cat in [
                                    { id: "theme", label: "🎨 Tema e Colori" },
                                    { id: "display", label: "🖥️ Visualizzazione e Controlli" },
                                    { id: "system", label: "⚙️ Sistema e Avvio" },
                                    { id: "updates", label: "✦ Aggiornamenti GitHub" },
                                ] : PillChip {
                                    label: cat.label;
                                    active: root.active-settings-cat == cat.id;
                                    accent: root.accent-main;
                                    text-col: root.text-main;
                                    surface-col: root.card-surface-elevated;
                                    clicked => { root.active-settings-cat = cat.id; }
                                }
                            }

                            // CATEGORIA 1: TEMA E COLORI
                            if root.active-settings-cat == "theme" : VerticalLayout {
                                spacing: 14px;

                                // Scelta Tema Chiaro / Scuro / Sistema
                                Rectangle {
                                    border-radius: 22px;
                                    background: root.card-surface-elevated;
                                    border-width: 1px;
                                    border-color: #ffffff30;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 12px;
                                        Text { text: "Modalità Tema"; color: root.text-main; font-size: 15px; font-weight: 700; }
                                        Text { text: "Scegli tra tema Chiaro, Scuro Fumé oppure sincronizzato col sistema Windows"; color: root.text-dim; font-size: 12px; }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            for t-opt in [
                                                { id: "light", label: "☀ Chiaro Cristallo" },
                                                { id: "dark", label: "☾ Scuro Fumé" },
                                                { id: "system", label: "💻 Sistema (Auto)" },
                                            ] : PillChip {
                                                label: t-opt.label;
                                                active: root.theme-pref == t-opt.id;
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => {
                                                    root.theme-pref = t-opt.id;
                                                    if (t-opt.id == "light") { root.dark-mode = false; }
                                                    if (t-opt.id == "dark") { root.dark-mode = true; }
                                                    root.save-settings();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Scelta Palette Colori Accento & Hero Card
                                Rectangle {
                                    border-radius: 22px;
                                    background: root.card-surface-elevated;
                                    border-width: 1px;
                                    border-color: #ffffff30;
                                    VerticalLayout {
                                        padding: 18px;
                                        spacing: 12px;
                                        Text { text: "Palette Colore & Stile Hero Card"; color: root.text-main; font-size: 15px; font-weight: 700; }
                                        Text { text: "Personalizza i colori della Hero Card, degli slider e delle luci soffuse"; color: root.text-dim; font-size: 12px; }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            for p-opt in [
                                                { id: "coral", label: "Coral Sunset (Default)" },
                                                { id: "cyan", label: "Ocean Cyan" },
                                                { id: "emerald", label: "Emerald Mint" },
                                                { id: "purple", label: "Royal Aurora" },
                                                { id: "amber", label: "Amber Gold" },
                                            ] : PillChip {
                                                label: p-opt.label;
                                                active: root.accent-palette == p-opt.id;
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => {
                                                    root.accent-palette = p-opt.id;
                                                    root.save-settings();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // CATEGORIA 2: VISUALIZZAZIONE E CONTROLLI
                            if root.active-settings-cat == "display" : Rectangle {
                                border-radius: 22px;
                                background: root.card-surface-elevated;
                                border-width: 1px;
                                border-color: #ffffff30;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 14px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Sincronizza tutti i monitor collegati"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: "Applica contemporaneamente luminosità, contrasto e colore a tutti gli schermi"; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        IosToggle {
                                            checked <=> root.sync-monitors;
                                            accent: root.accent-main;
                                            toggled => { root.save-settings(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Vista Predefinita all'Avvio"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: "Scegli se aprire la Dashboard Singola o Tutti i Monitor Affiancati"; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            PillChip {
                                                label: "Dashboard Singola";
                                                active: root.layout-mode == "single";
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => { root.layout-mode = "single"; root.save-settings(); }
                                            }
                                            PillChip {
                                                label: "Tutti Affiancati";
                                                active: root.layout-mode == "multi";
                                                accent: root.accent-main;
                                                text-col: root.text-main;
                                                surface-col: root.card-surface;
                                                clicked => { root.layout-mode = "multi"; root.save-settings(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // CATEGORIA 3: SISTEMA E AVVIO
                            if root.active-settings-cat == "system" : Rectangle {
                                border-radius: 22px;
                                background: root.card-surface-elevated;
                                border-width: 1px;
                                border-color: #ffffff30;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 14px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Riduci nella System Tray alla chiusura (Modalità Gaming ~8 MB)"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: "Sospende la finestra e libera la RAM lasciando l'icona vicino all'orologio"; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        IosToggle {
                                            checked <=> root.close-to-tray;
                                            accent: root.accent-main;
                                            toggled => { root.save-settings(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Avvia automaticamente con Windows"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: "Avvia Monitor Manager ridotto nella System Tray all'accensione del PC"; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        IosToggle {
                                            checked <=> root.start-with-windows;
                                            accent: root.accent-main;
                                            toggled => { root.save-settings(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Chiudi Completamente Monitor Manager"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: "Termina il processo anche dalla System Tray"; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        PillChip {
                                            label: "Esci dall'App";
                                            active: true;
                                            accent: #ef4444;
                                            clicked => { root.quit-app(); }
                                        }
                                    }
                                }
                            }

                            // CATEGORIA 4: AGGIORNAMENTI GITHUB
                            if root.active-settings-cat == "updates" : Rectangle {
                                border-radius: 22px;
                                background: root.card-surface-elevated;
                                border-width: 1px;
                                border-color: #ffffff30;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 14px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Controllo automatico aggiornamenti all'avvio"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: "Repository: github.com/riccardo-bettini/Monitor-Manager"; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        IosToggle {
                                            checked <=> root.auto-check-updates;
                                            accent: root.accent-main;
                                            toggled => { root.save-settings(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        VerticalLayout {
                                            Text { text: "Versione Installata: v\{root.app-version}"; color: root.text-main; font-size: 13.5px; font-weight: 700; }
                                            Text { text: root.update-status-text; color: root.text-dim; font-size: 11.5px; }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            PillChip {
                                                label: "Verifica aggiornamenti ora";
                                                active: true;
                                                accent: root.accent-main;
                                                clicked => { root.check-updates(); }
                                            }
                                            if root.update-available : PillChip {
                                                label: "Installa v\{root.latest-version}";
                                                active: true;
                                                accent: #10b981;
                                                clicked => { root.install-update(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SetupWindow inherits Window {
    title: "Monitor Manager v1.02 — Setup";
    preferred-width: 520px;
    preferred-height: 420px;
    min-width: 520px;
    min-height: 420px;
    max-width: 520px;
    max-height: 420px;
    background: #171110;

    in-out property <string> install-path: "";
    in-out property <bool> opt-desktop: true;
    in-out property <bool> opt-start-menu: true;
    in-out property <bool> opt-autostart: false;
    in-out property <bool> opt-launch: true;
    in-out property <bool> installing: false;
    in-out property <bool> installed: false;
    in-out property <string> status-text: "Pronto per l'installazione ultra-leggera (Zero WebView)";

    callback start-install();
    callback finish-setup();

    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(135deg, #171110 0%, #2a1d1a 55%, #171110 100%);

        VerticalLayout {
            padding: 22px;
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    background: @linear-gradient(135deg, #df4b3b 0%, #b83227 100%);
                    Text {
                        text: "MM";
                        color: #ffffff;
                        font-size: 15px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "Monitor Manager — Setup v1.02"; color: #ffffff; font-size: 17px; font-weight: 800; }
                    Text { text: "Edizione Nativa Ultra-Leggera (~8 MB RAM in background)"; color: #ffffffb0; font-size: 11.5px; }
                }
            }

            Rectangle {
                border-radius: 14px;
                background: #ffffff12;
                border-width: 1px;
                border-color: #ffffff24;
                VerticalLayout {
                    padding: 10px;
                    spacing: 2px;
                    Text { text: "CARTELLA DI INSTALLAZIONE"; color: #df4b3b; font-size: 10px; font-weight: 700; }
                    Text { text: root.install-path; color: #ffffffdd; font-size: 11.5px; overflow: elide; }
                }
            }

            Rectangle {
                border-radius: 18px;
                background: #ffffff12;
                border-width: 1px;
                border-color: #ffffff24;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Crea collegamento sul Desktop"; color: #ffffff; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
                        IosToggle { checked <=> root.opt-desktop; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Aggiungi al Menu Start di Windows"; color: #ffffff; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
                        IosToggle { checked <=> root.opt-start-menu; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Avvia automaticamente con Windows"; color: #ffffff; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
                        IosToggle { checked <=> root.opt-autostart; }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Avvia Monitor Manager al termine"; color: #ffffff; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
                        IosToggle { checked <=> root.opt-launch; }
                    }
                }
            }

            Text {
                text: root.status-text;
                color: root.installed ? #34d399 : #ffffffcc;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 42px;
                border-radius: 16px;
                background: @linear-gradient(135deg, #df4b3b 0%, #b83227 100%);
                border-width: 1px;
                border-color: #ffffff66;
                Text {
                    text: root.installed ? (root.opt-launch ? "Avvia Monitor Manager e Chiudi" : "Chiudi Setup") :
                          root.installing ? "Installazione in corso..." : "Installa Monitor Manager v1.02";
                    color: #ffffff;
                    font-size: 13.5px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    enabled: !root.installing;
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.installed) {
                            root.finish-setup();
                        } else {
                            root.start-install();
                        }
                    }
                }
            }
        }
    }
}
