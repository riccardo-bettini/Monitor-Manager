import { ScrollView } from "std-widgets.slint";

export struct UiMonitor {
    id: int,
    name: string,
    brand: string,
    resolution: string,
    is-primary: bool,
    ddc-supported: bool,
    is-internal-wmi: bool,
    brightness: int,
    brightness-max: int,
    brightness-sup: bool,
    contrast: int,
    contrast-max: int,
    contrast-sup: bool,
    sharpness: int,
    sharpness-max: int,
    sharpness-sup: bool,
    saturation: int,
    saturation-max: int,
    saturation-sup: bool,
    red-gain: int,
    green-gain: int,
    blue-gain: int,
    rgb-sup: bool,
    color-temp: int,
    color-temp-sup: bool,
    volume: int,
    volume-sup: bool,
    input-source: int,
    input-sup: bool,
}

// ============================================================================
// TEMA GLOBALE ANIMAZIONI A MOLLA (SPRING ANIMATIONS) & ZERO OVERHEAD
// ============================================================================
export global SpringTheme {
    in-out property <bool> animations-enabled: true;
}

// ============================================================================
// ICONE VETTORIALI NITIDE (SOSTITUISCONO TUTTE LE EMOJI / GLIFI UNICODE BROKEN)
// ============================================================================
component HomeGlyph inherits Rectangle {
    in property <color> icon-color: #9da5b4;
    width: 16px;
    height: 16px;
    background: transparent;

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        MoveTo { x: 3; y: 10.5; }
        LineTo { x: 12; y: 3.5; }
        LineTo { x: 21; y: 10.5; }
        MoveTo { x: 5.5; y: 8.8; }
        LineTo { x: 5.5; y: 20; }
        LineTo { x: 18.5; y: 20; }
        LineTo { x: 18.5; y: 8.8; }
        MoveTo { x: 9.5; y: 20; }
        LineTo { x: 9.5; y: 14; }
        LineTo { x: 14.5; y: 14; }
        LineTo { x: 14.5; y: 20; }
    }
}

component DisplayGlyph inherits Rectangle {
    in property <color> icon-color: #9da5b4;
    in property <bool> is-laptop: false;
    width: 16px;
    height: 16px;
    background: transparent;

    // Cornice pannello (monitor o portatile)
    Rectangle {
        x: root.is-laptop ? 2px : 1px;
        y: root.is-laptop ? 2px : 2px;
        width: root.is-laptop ? 12px : 14px;
        height: root.is-laptop ? 9px : 9.5px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.icon-color;
        background: transparent;
    }
    // Gambo desktop (solo display esterni)
    if !root.is-laptop : Rectangle {
        x: 7px;
        y: 11.5px;
        width: 2px;
        height: 2px;
        background: root.icon-color;
    }
    // Base monitor desktop o scocca tastiera portatile
    Rectangle {
        x: root.is-laptop ? 0.5px : 4.5px;
        y: root.is-laptop ? 12px : 13.5px;
        width: root.is-laptop ? 15px : 7px;
        height: root.is-laptop ? 2px : 1.6px;
        border-radius: 0.8px;
        background: root.icon-color;
    }
}

component DashboardGlyph inherits Rectangle {
    in property <color> icon-color: #9da5b4;
    width: 14px;
    height: 14px;
    background: transparent;

    Rectangle { x: 1px; y: 1px; width: 5px; height: 5px; border-radius: 1.5px; border-width: 1.4px; border-color: root.icon-color; }
    Rectangle { x: 8px; y: 1px; width: 5px; height: 5px; border-radius: 1.5px; border-width: 1.4px; border-color: root.icon-color; }
    Rectangle { x: 1px; y: 8px; width: 5px; height: 5px; border-radius: 1.5px; border-width: 1.4px; border-color: root.icon-color; }
    Rectangle { x: 8px; y: 8px; width: 5px; height: 5px; border-radius: 1.5px; background: root.icon-color; }
}

component ProfileGlyph inherits Rectangle {
    in property <color> icon-color: #9da5b4;
    width: 14px;
    height: 14px;
    background: transparent;

    Rectangle {
        x: 1px;
        y: 1px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: root.icon-color;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 6px;
            height: 12px;
            background: root.icon-color;
        }
    }
}

component ReorderGlyph inherits Rectangle {
    in property <color> icon-color: #9da5b4;
    width: 16px;
    height: 16px;
    background: transparent;

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: 1.9px;
        stroke-line-cap: round;
        MoveTo { x: 8; y: 19; }
        LineTo { x: 8; y: 5; }
        MoveTo { x: 4.5; y: 8.5; }
        LineTo { x: 8; y: 5; }
        LineTo { x: 11.5; y: 8.5; }
        MoveTo { x: 16; y: 5; }
        LineTo { x: 16; y: 19; }
        MoveTo { x: 12.5; y: 15.5; }
        LineTo { x: 16; y: 19; }
        LineTo { x: 19.5; y: 15.5; }
    }
}

component SettingsGlyph inherits Rectangle {
    in property <color> icon-color: #9da5b4;
    width: 16px;
    height: 16px;
    background: transparent;

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        // 3 slider orizzontali minimal moderni
        MoveTo { x: 4; y: 6.5; }
        LineTo { x: 20; y: 6.5; }
        MoveTo { x: 4; y: 12; }
        LineTo { x: 20; y: 12; }
        MoveTo { x: 4; y: 17.5; }
        LineTo { x: 20; y: 17.5; }
    }
    Rectangle { x: 9px; y: 2.3px; width: 4px; height: 4px; border-radius: 2px; background: root.icon-color; }
    Rectangle { x: 4px; y: 6px; width: 4px; height: 4px; border-radius: 2px; background: root.icon-color; }
    Rectangle { x: 10px; y: 9.7px; width: 4px; height: 4px; border-radius: 2px; background: root.icon-color; }
}

component DragGripGlyph inherits Rectangle {
    in property <color> icon-color: #8a92a2;
    width: 14px;
    height: 16px;
    background: transparent;

    Rectangle { x: 2px; y: 2px; width: 3px; height: 3px; border-radius: 1.5px; background: root.icon-color; }
    Rectangle { x: 8px; y: 2px; width: 3px; height: 3px; border-radius: 1.5px; background: root.icon-color; }
    Rectangle { x: 2px; y: 6.5px; width: 3px; height: 3px; border-radius: 1.5px; background: root.icon-color; }
    Rectangle { x: 8px; y: 6.5px; width: 3px; height: 3px; border-radius: 1.5px; background: root.icon-color; }
    Rectangle { x: 2px; y: 11px; width: 3px; height: 3px; border-radius: 1.5px; background: root.icon-color; }
    Rectangle { x: 8px; y: 11px; width: 3px; height: 3px; border-radius: 1.5px; background: root.icon-color; }
}

component CategoryBadge inherits Rectangle {
    in property <color> accent: #f05a46;
    in property <string> kind: "system"; // "system" | "style" | "hardware" | "updates"
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: root.accent.with-alpha(0.16);
    border-width: 1px;
    border-color: root.accent.with-alpha(0.35);

    if root.kind == "system" : DisplayGlyph {
        x: 6px;
        y: 6px;
        icon-color: root.accent;
    }
    if root.kind == "style" : ProfileGlyph {
        x: 7px;
        y: 7px;
        icon-color: root.accent;
    }
    if root.kind == "hardware" : ReorderGlyph {
        x: 6px;
        y: 6px;
        icon-color: root.accent;
    }
    if root.kind == "updates" : Path {
        width: 16px;
        height: 16px;
        x: 6px;
        y: 6px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.accent;
        stroke-width: 2px;
        stroke-line-cap: round;
        MoveTo { x: 12; y: 4; }
        LineTo { x: 12; y: 15; }
        MoveTo { x: 7.5; y: 11; }
        LineTo { x: 12; y: 15.5; }
        LineTo { x: 16.5; y: 11; }
        MoveTo { x: 5; y: 19.5; }
        LineTo { x: 19; y: 19.5; }
    }
}

// ============================================================================
// SLIDER DARK MATTE TITANIUM CON THUMB GLOW, TRACK COLORATA, WHEEL E FRECCE TASTIERA
// ============================================================================
component NeonSlider inherits Rectangle {
    in-out property <int> value: 50;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <color> track-color: #ff5733;
    in property <string> glow-style: "subtle";
    in property <bool> enabled: true;
    callback changed(int);

    height: 24px;
    background: transparent;

    property <float> ratio: Math.clamp(
        root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0.0,
        0.0,
        1.0
    );

    public function step-by(delta: int) {
        let nv = Math.clamp(root.value + delta, root.minimum, root.maximum);
        if (nv != root.value) {
            root.value = nv;
            root.changed(nv);
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;

        key-pressed(ev) => {
            if (ev.text == Key.LeftArrow || ev.text == Key.DownArrow) {
                root.step-by(-2);
                return accept;
            }
            if (ev.text == Key.RightArrow || ev.text == Key.UpArrow) {
                root.step-by(2);
                return accept;
            }
            reject
        }

        // Corsia di fondo scura opaca
        track-bg := Rectangle {
            y: (parent.height - self.height) / 2;
            height: 6px;
            width: 100%;
            border-radius: 3px;
            background: #3c4250;

            // Parte attiva colorata
            active-track := Rectangle {
                x: 0px;
                y: 0px;
                height: 100%;
                width: parent.width * root.ratio;
                border-radius: 3px;
                background: root.enabled ? root.track-color : #555b69;

                animate width {
                    duration: SpringTheme.animations-enabled && !ta.pressed ? 200ms : 0ms;
                    easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                }
            }
        }

        // Alone Glow attorno al cursore (opzionale in base a glow-style, con rimbalzo a molla)
        if root.enabled && root.glow-style != "none" : Rectangle {
            width: (root.glow-style == "intense" ? 24px : 20px) + (ta.has-hover ? 4px : 0px);
            height: self.width;
            border-radius: self.width / 2;
            x: (parent.width - 16px) * root.ratio + 8px - self.width / 2;
            y: (parent.height - self.height) / 2;
            background: root.track-color.with-alpha(root.glow-style == "intense" ? 0.35 : 0.20);

            animate x {
                duration: SpringTheme.animations-enabled && !ta.pressed ? 200ms : 0ms;
                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
            }
            animate width, height {
                duration: SpringTheme.animations-enabled ? 180ms : 0ms;
                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
            }
        }

        // Thumb circolare con anello scuro interno e animazione a molla elastica
        thumb := Rectangle {
            width: ta.pressed ? 19px : (ta.has-hover ? 18px : 16px);
            height: self.width;
            border-radius: self.width / 2;
            x: (parent.width - self.width) * root.ratio;
            y: (parent.height - self.height) / 2;
            background: root.enabled ? root.track-color : #6c7382;
            border-width: 2.5px;
            border-color: #21252e;

            animate x {
                duration: SpringTheme.animations-enabled && !ta.pressed ? 200ms : 0ms;
                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
            }
            animate width, height {
                duration: SpringTheme.animations-enabled ? 180ms : 0ms;
                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
            }
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;

            function update-from-mouse(mx: length) {
                if (root.width > 0px) {
                    let r = Math.clamp(mx / root.width, 0.0, 1.0);
                    let nv = Math.round(root.minimum + r * (root.maximum - root.minimum));
                    if (nv != root.value) {
                        root.value = nv;
                        root.changed(nv);
                    }
                }
            }

            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    fs.focus();
                    self.update-from-mouse(self.mouse-x);
                }
            }

            moved => {
                if (self.enabled && self.pressed) {
                    self.update-from-mouse(self.mouse-x);
                }
            }

            scroll-event(ev) => {
                if (root.enabled) {
                    fs.focus();
                    let d = ev.delta-y != 0px
                        ? (ev.delta-y > 0px ? 2 : -2)
                        : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
                    if (d != 0) {
                        root.step-by(d);
                    }
                }
                accept
            }
        }
    }
}

// ============================================================================
// GAUGE CIRCOLARE VETTORIALE SVG AD ARCO (260°) — NITIDA ALTA DEFINIZIONE
// ============================================================================
component ArcGauge inherits Rectangle {
    in property <int> percentage: 75;
    in property <string> label: "Luminosità";
    in property <color> accent: #f05a46;
    in property <string> glow-style: "subtle";
    callback adjusted(int);

    property <float> animated-pct: Math.clamp(root.percentage, 0, 100);
    animate animated-pct {
        duration: SpringTheme.animations-enabled ? 220ms : 0ms;
        easing: cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    property <angle> start-ang: 140deg;
    property <angle> sweep-ang: Math.max(0.5, root.animated-pct * 2.6) * 1deg;
    property <angle> end-ang: root.start-ang + root.sweep-ang;

    width: 122px;
    height: 122px;
    background: transparent;

    ta-gauge := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        scroll-event(ev) => {
            let d = ev.delta-y != 0px
                ? (ev.delta-y > 0px ? 2 : -2)
                : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
            if (d != 0) {
                let nv = Math.clamp(root.percentage + d, 0, 100);
                root.adjusted(nv);
            }
            accept
        }
    }

    // Alone sottile dietro l'anello quando glow != none
    if root.glow-style != "none" : Rectangle {
        width: 106px;
        height: 106px;
        border-radius: 53px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.accent.with-alpha(root.glow-style == "intense" ? 0.14 : 0.06);
    }

    // Sfondo interno circolare satinato scuro
    Rectangle {
        width: 82px;
        height: 82px;
        border-radius: 41px;
        background: #171b23;
        border-width: 1px;
        border-color: #262c38;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // Traccia di fondo continua 260°
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: transparent;
        stroke: #2a303d;
        stroke-width: 8.5px;
        stroke-line-cap: round;

        MoveTo { x: 50 + 40 * Math.cos(140deg); y: 50 + 40 * Math.sin(140deg); }
        ArcTo {
            radius-x: 40;
            radius-y: 40;
            large-arc: true;
            sweep: true;
            x: 50 + 40 * Math.cos(400deg);
            y: 50 + 40 * Math.sin(400deg);
        }
    }

    // Arco attivo colorato animato ad alta definizione
    if root.animated-pct > 0.4 : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: transparent;
        stroke: root.accent;
        stroke-width: 8.5px;
        stroke-line-cap: round;

        MoveTo { x: 50 + 40 * Math.cos(root.start-ang); y: 50 + 40 * Math.sin(root.start-ang); }
        ArcTo {
            radius-x: 40;
            radius-y: 40;
            large-arc: root.sweep-ang > 180deg;
            sweep: true;
            x: 50 + 40 * Math.cos(root.end-ang);
            y: 50 + 40 * Math.sin(root.end-ang);
        }
    }

    // Testo centrale percentuale + dicitura nitida
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text {
            text: "\{root.percentage}%";
            color: #ffffff;
            font-size: 25px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: #9da5b4;
            font-size: 10.5px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

// ============================================================================
// STAT CARD COMPATTE DEL QUARTETTO CENTRALE (Brightness, Contrast, Sharpness, Saturation)
// ============================================================================
component TitaniumStatCard inherits Rectangle {
    in property <string> title: "Brightness:";
    in-out property <int> value: 75;
    in property <int> maximum: 100;
    in property <bool> supported: true;
    in property <color> accent: #ff5733;
    in property <string> glow-style: "subtle";
    in property <bool> compact: false;
    callback changed(int);

    height: root.compact ? 112px : 128px;
    border-radius: 10px;
    background: ta-card.has-hover ? #252a35 : #21252e;
    border-width: 1px;
    border-color: ta-card.has-hover ? root.accent.with-alpha(0.55) : #2d323e;

    animate background, border-color {
        duration: SpringTheme.animations-enabled ? 200ms : 0ms;
        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    ta-card := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.supported;
        scroll-event(ev) => {
            if (root.supported) {
                let d = ev.delta-y != 0px
                    ? (ev.delta-y > 0px ? 2 : -2)
                    : (ev.delta-x > 0px ? 2 : (ev.delta-x < 0px ? -2 : 0));
                if (d != 0) {
                    let nv = Math.clamp(root.value + d, 0, root.maximum);
                    if (nv != root.value) {
                        root.value = nv;
                        root.changed(nv);
                    }
                }
            }
            accept
        }
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: root.compact ? 12px : 14px;
        padding-bottom: root.compact ? 10px : 12px;
        alignment: space-between;

        Text {
            text: root.supported ? root.title : "\{root.title} (N/D)";
            color: root.supported ? #c5cbd6 : #707888;
            font-size: 13px;
            font-weight: 500;
        }

        Text {
            text: root.supported ? "\{Math.round(root.value * 100 / Math.max(1, root.maximum))}%" : "--";
            color: root.supported ? #ffffff : #6b7280;
            font-size: root.compact ? 28px : 33px;
            font-weight: 700;
        }

        NeonSlider {
            value <=> root.value;
            minimum: 0;
            maximum: root.maximum;
            track-color: root.accent;
            glow-style: root.glow-style;
            enabled: root.supported;
            changed(v) => { root.changed(v); }
        }
    }
}

// ============================================================================
// SWITCH TOGGLE TITANIUM PER LE IMPOSTAZIONI CON RIMBALZO A MOLLA ELASTICO
// ============================================================================
component TitaniumToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <color> accent: #ff5733;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? root.accent : #363b47;
    border-width: 1px;
    border-color: root.checked ? root.accent : #454b59;

    animate background, border-color {
        duration: SpringTheme.animations-enabled ? 200ms : 0ms;
        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        background: #ffffff;
        animate x {
            duration: SpringTheme.animations-enabled ? 240ms : 0ms;
            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ============================================================================
// PULSANTE CHIP TITANIUM CON FEEDBACK A MOLLA
// ============================================================================
component TitaniumChip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> accent: #ff5733;
    in property <string> glow-style: "subtle";
    in property <bool> enabled: true;
    in property <bool> subtle-danger: false;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    opacity: root.enabled ? 1.0 : 0.55;
    background: !root.enabled
        ? #232732
        : (root.subtle-danger
            ? (ta-chip.has-hover ? #f05a46.with-alpha(0.24) : #f05a46.with-alpha(0.14))
            : (root.active ? root.accent.with-alpha(0.18) : (ta-chip.has-hover ? #323846 : #282d38)));
    border-width: root.active && !root.subtle-danger ? (root.glow-style == "intense" ? 2px : 1.5px) : 1px;
    border-color: !root.enabled
        ? #303542
        : (root.subtle-danger
            ? (ta-chip.has-hover ? #ff705c : #f05a46.with-alpha(0.65))
            : (root.active ? root.accent : (ta-chip.has-hover ? root.accent.with-alpha(0.4) : #363c4a)));

    animate background, border-color, opacity {
        duration: SpringTheme.animations-enabled ? 180ms : 0ms;
        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            color: !root.enabled ? #8b93a6 : (root.subtle-danger ? #ffd4ce : (root.active ? #ffffff : #dce1eb));
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    ta-chip := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

component AccentSwatchChip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <color> swatch-color: #f05a46;
    in property <string> glow-style: "subtle";
    callback clicked();

    height: 32px;
    border-radius: 7px;
    background: root.active ? root.swatch-color.with-alpha(0.18) : (ta-sw.has-hover ? #323846 : #282d38);
    border-width: root.active ? (root.glow-style == "intense" ? 2px : 1.5px) : 1px;
    border-color: root.active ? root.swatch-color : (ta-sw.has-hover ? root.swatch-color.with-alpha(0.45) : #363c4a);

    animate background, border-color {
        duration: SpringTheme.animations-enabled ? 180ms : 0ms;
        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;

        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.swatch-color;
        }
        Text {
            text: root.text;
            color: root.active ? #ffffff : #b8bfcc;
            font-size: 11.5px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    ta-sw := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component HomeMonitorCard inherits Rectangle {
    in property <UiMonitor> mon;
    in property <int> mon-index: 0;
    in property <color> accent-main: #f05a46;
    in property <string> glow-style: "subtle";
    in property <bool> is-en: false;
    in property <bool> hide-unsupported: false;
    callback set-vcp(int, int, int);
    callback open-details(int);

    border-radius: 12px;
    background: card-hover.has-hover ? #252a35 : #21252e;
    border-width: 1px;
    border-color: card-hover.has-hover ? root.accent-main.with-alpha(0.55) : #2d323e;

    animate background, border-color {
        duration: SpringTheme.animations-enabled ? 200ms : 0ms;
        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    card-hover := TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // Intestazione card monitor
        HorizontalLayout {
            alignment: space-between;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                horizontal-stretch: 1;

                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: #1a1e26;
                    border-width: 1px;
                    border-color: #2c3240;

                    DisplayGlyph {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        is-laptop: root.mon.is-internal-wmi;
                        icon-color: root.mon.ddc-supported || root.mon.is-internal-wmi ? root.accent-main : #8a92a2;
                    }
                }

                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: root.mon.name;
                        color: #ffffff;
                        font-size: 15px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3.5px;
                            background: root.mon.ddc-supported ? #39d353 : (root.mon.is-internal-wmi ? #38bdf8 : #f59e0b);
                        }
                        Text {
                            text: root.mon.ddc-supported
                                ? (root.is-en ? "DDC/CI Active" : "DDC/CI Attivo")
                                : (root.mon.is-internal-wmi
                                    ? (root.is-en ? "Internal WMI" : "WMI Integrato")
                                    : (root.is-en ? "Read-Only" : "Solo Lettura"));
                            color: root.mon.ddc-supported ? #39d353 : (root.mon.is-internal-wmi ? #38bdf8 : #f59e0b);
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }
            }

            Rectangle {
                height: 24px;
                y: 4px;
                border-radius: 6px;
                background: #1b1e27;
                border-width: 1px;
                border-color: #2c3240;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.mon.resolution;
                        color: #9da5b4;
                        font-size: 10.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Controllo Luminosità + Preset rapidi
        if !root.hide-unsupported || root.mon.brightness-sup : VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.is-en ? "Brightness" : "Luminosità";
                    color: root.mon.brightness-sup ? #c5cbd6 : #6b7280;
                    font-size: 12px;
                    font-weight: 600;
                }
                Text {
                    text: "\{root.mon.brightness}%";
                    color: root.mon.brightness-sup ? root.accent-main : #6b7280;
                    font-size: 12px;
                    font-weight: 700;
                }
            }
            NeonSlider {
                value: root.mon.brightness;
                minimum: 0;
                maximum: root.mon.brightness-max;
                track-color: root.accent-main;
                glow-style: root.glow-style;
                enabled: root.mon.brightness-sup;
                changed(v) => { root.set-vcp(root.mon.id, 16, v); }
            }
            if root.mon.brightness-sup : HorizontalLayout {
                spacing: 6px;
                padding-top: 2px;
                TitaniumChip {
                    horizontal-stretch: 1;
                    height: 26px;
                    text: "100%";
                    active: root.mon.brightness == 100;
                    accent: root.accent-main;
                    glow-style: root.glow-style;
                    clicked => { root.set-vcp(root.mon.id, 16, 100); }
                }
                TitaniumChip {
                    horizontal-stretch: 1;
                    height: 26px;
                    text: "65%";
                    active: root.mon.brightness == 65;
                    accent: root.accent-main;
                    glow-style: root.glow-style;
                    clicked => { root.set-vcp(root.mon.id, 16, 65); }
                }
                TitaniumChip {
                    horizontal-stretch: 1;
                    height: 26px;
                    text: "35%";
                    active: root.mon.brightness == 35;
                    accent: root.accent-main;
                    glow-style: root.glow-style;
                    clicked => { root.set-vcp(root.mon.id, 16, 35); }
                }
            }
        }

        // Controllo Contrasto (nascosto automaticamente se non supportato con filtro attivo)
        if !root.hide-unsupported || root.mon.contrast-sup : VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.mon.contrast-sup
                        ? (root.is-en ? "Contrast" : "Contrasto")
                        : (root.is-en ? "Contrast (N/A)" : "Contrasto (N/D)");
                    color: root.mon.contrast-sup ? #c5cbd6 : #6b7280;
                    font-size: 12px;
                    font-weight: 600;
                }
                Text {
                    text: root.mon.contrast-sup ? "\{root.mon.contrast}%" : "--";
                    color: root.mon.contrast-sup ? root.accent-main : #6b7280;
                    font-size: 12px;
                    font-weight: 700;
                }
            }
            NeonSlider {
                value: root.mon.contrast;
                minimum: 0;
                maximum: root.mon.contrast-max;
                track-color: root.accent-main;
                glow-style: root.glow-style;
                enabled: root.mon.contrast-sup;
                changed(v) => { root.set-vcp(root.mon.id, 18, v); }
            }
        }

        if root.hide-unsupported && !root.mon.brightness-sup && !root.mon.contrast-sup : Rectangle {
            height: 36px;
            border-radius: 8px;
            background: #1b1e27;
            Text {
                text: root.is-en
                    ? "No DDC/CI or WMI brightness control exposed."
                    : "Nessun controllo DDC/CI o WMI esposto.";
                color: #8a92a2;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Pulsante Azione: Apri Dashboard & RGB
        Rectangle {
            height: 34px;
            border-radius: 8px;
            background: btn-ta.has-hover ? root.accent-main : #2a303d;
            border-width: 1px;
            border-color: btn-ta.has-hover ? root.accent-main : #384050;

            animate background, border-color {
                duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
            }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: root.mon.is-internal-wmi
                        ? (root.is-en ? "Display Controls" : "Controlli Display")
                        : (root.is-en ? "Monitor Details & RGB" : "Dettagli Monitor & RGB");
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            btn-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-details(root.mon-index); }
            }
        }
    }
}

component ReorderCardRow inherits Rectangle {
    in property <UiMonitor> mon;
    in property <int> rank: 1;
    in property <color> accent-main: #f05a46;
    in property <bool> is-en: false;
    in property <bool> is-dragged: false;
    in property <bool> is-hovered: false;
    in property <bool> dimmed: false;

    height: 68px;
    border-radius: 12px;
    background: root.is-dragged ? #2c3342 : (root.is-hovered ? #262b36 : #21252e);
    border-width: root.is-dragged ? 2px : (root.is-hovered ? 1.5px : 1px);
    border-color: root.is-dragged ? root.accent-main : (root.is-hovered ? root.accent-main.with-alpha(0.45) : #2d323e);
    opacity: root.dimmed ? 0.72 : 1.0;
    drop-shadow-blur: root.is-dragged ? 20px : 0px;
    drop-shadow-color: root.is-dragged ? #00000090 : transparent;
    drop-shadow-offset-y: root.is-dragged ? 8px : 0px;

    animate background, border-color, opacity {
        duration: SpringTheme.animations-enabled ? 160ms : 0ms;
        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 16px;
            alignment: start;

            // Badge posizione numerica (#1, #2...)
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: (root.is-dragged || root.is-hovered)
                    ? root.accent-main.with-alpha(0.30)
                    : root.accent-main.with-alpha(0.18);
                border-width: 1px;
                border-color: root.accent-main;

                Text {
                    text: "#\{root.rank}";
                    color: root.accent-main;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;

                Text {
                    text: root.mon.name;
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: root.mon.ddc-supported
                        ? "\{root.mon.brand} · \{root.mon.resolution} · DDC/CI Attivo"
                        : (root.mon.is-internal-wmi
                            ? "\{root.mon.brand} · \{root.mon.resolution} · WMI Integrato"
                            : "\{root.mon.brand} · \{root.mon.resolution} · Solo Lettura");
                    color: #9da5b4;
                    font-size: 11px;
                }
            }
        }

        // Maniglia di presa vettoriale a 6 punti
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: root.is-dragged
                    ? (root.is-en ? "Position #\{root.rank}" : "Posizione #\{root.rank}")
                    : (root.is-en ? "Drag to reorder" : "Trascina per ordinare");
                color: root.is-dragged ? root.accent-main : (root.is-hovered ? #c3c9d5 : #6c7382);
                font-size: 11.5px;
                font-weight: root.is-dragged ? 700 : 500;
                vertical-alignment: center;
            }

            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                border-radius: 7px;
                background: root.is-dragged
                    ? root.accent-main.with-alpha(0.25)
                    : (root.is-hovered ? #2e3442 : #1c2028);
                border-width: 1px;
                border-color: root.is-dragged
                    ? root.accent-main
                    : (root.is-hovered ? #40495c : #252a35);

                DragGripGlyph {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: root.is-dragged ? root.accent-main : (root.is-hovered ? #ffffff : #8a92a2);
                }
            }
        }
    }
}

// ============================================================================
// FINESTRA PRINCIPALE: DARK MATTE TITANIUM (BORDERLESS CON TOP BAR INTEGRATA)
// ============================================================================
export component AppWindow inherits Window {
    title: "Monitor Manager";
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 980px;
    preferred-height: 600px;
    min-width: 860px;
    min-height: 540px;
    background: transparent;

    // --- Proprietà di Stato Principali ---
    in-out property <[UiMonitor]> monitors: [
        {
            id: 0,
            name: "ASUS TUF Gaming VG27A",
            brand: "ASUS",
            resolution: "2560×1440 | 165Hz",
            is-primary: true,
            ddc-supported: true,
            is-internal-wmi: false,
            brightness: 75,
            brightness-max: 100,
            brightness-sup: true,
            contrast: 50,
            contrast-max: 100,
            contrast-sup: true,
            sharpness: 60,
            sharpness-max: 100,
            sharpness-sup: true,
            saturation: 50,
            saturation-max: 100,
            saturation-sup: true,
            red-gain: 50,
            green-gain: 50,
            blue-gain: 50,
            rgb-sup: true,
            color-temp: 5,
            color-temp-sup: true,
            volume: 40,
            volume-sup: true,
            input-source: 15,
            input-sup: true,
        }
    ];
    in-out property <int> selected-monitor-index: 0;
    // "home" | "dashboard" | "profiles" | "reorder" | "settings"
    in-out property <string> active-view: "home";

    // Proprietà reattive dirette per slider ultra-reattivi (zero delay, zero freeze)
    in-out property <int> current-brightness: 75;
    in-out property <int> current-contrast: 50;
    in-out property <int> current-sharpness: 60;
    in-out property <int> current-saturation: 50;
    in-out property <int> current-red-gain: 50;
    in-out property <int> current-green-gain: 50;
    in-out property <int> current-blue-gain: 50;
    in-out property <int> current-volume: 40;

    public function sync-current-values() {
        if (root.monitors.length > 0) {
            let idx = Math.clamp(root.selected-monitor-index, 0, root.monitors.length - 1);
            let m = root.monitors[idx];
            root.current-brightness = m.brightness;
            root.current-contrast = m.contrast;
            root.current-sharpness = m.sharpness;
            root.current-saturation = m.saturation;
            root.current-red-gain = m.red-gain;
            root.current-green-gain = m.green-gain;
            root.current-blue-gain = m.blue-gain;
            root.current-volume = m.volume;
        }
    }

    // --- Impostazioni Personalizzazione (Zero RAM Overhead) ---
    // Lingua: "it" | "en"
    in-out property <string> lang: "it";
    // Palette Accento: "coral" | "cyan" | "emerald" | "violet" | "amber"
    in-out property <string> accent-palette: "coral";
    // Stile Glow Bordi: "none" | "subtle" | "intense"
    in-out property <string> glow-style: "subtle";
    // Densità Layout: "standard" | "compact"
    in-out property <string> layout-density: "standard";
    // Vera Trasparenza Windows Acrylic (DWM) sulla sidebar
    in-out property <bool> acrylic-enabled: true;
    // Animazioni fluide a molla (Spring animations) in tutta l'interfaccia
    in-out property <bool> animations-enabled <=> SpringTheme.animations-enabled;

    // Impostazioni Funzionali & Sistema
    in-out property <string> layout-mode: "single";
    in-out property <bool> sync-monitors: false;
    in-out property <bool> hide-unsupported: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <bool> window-maximized: false;

    // Stato Auto-Updater GitHub
    in-out property <string> app-version: "1.14";
    in-out property <string> update-status-text: "Monitor Manager v1.14 (Frosted Acrylic, WMI Laptop & Native Vector UI)";
    in-out property <bool> update-available: false;
    in-out property <string> latest-version: "1.14";
    in-out property <bool> update-checking: false;
    in-out property <bool> update-downloading: false;
    in-out property <bool> update-installing: false;
    in-out property <bool> update-failed: false;
    in-out property <float> update-progress: 0.0;
    in-out property <bool> update-indeterminate: false;
    in-out property <string> update-progress-phase: "";
    in-out property <string> update-progress-detail: "";

    // --- Callbacks verso Rust ---
    callback set-vcp(int /* monitor_id */, int /* vcp_code */, int /* value */);
    callback apply-preset(int /* monitor_id */, int /* lum */, int /* con */);
    callback reset-rgb(int /* monitor_id */);
    callback rescan-monitors();
    callback save-settings();
    callback check-updates();
    callback install-update();
    callback cancel-update();
    callback quit-app();
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback move-monitor(int /* from_idx */, int /* to_idx */);
    callback toggle-acrylic(bool);

    // --- Palette Colori Reattive ---
    property <bool> is-en: root.lang == "en";
    property <bool> is-compact: root.layout-density == "compact";

    property <color> accent-main:
        root.accent-palette == "cyan" ? #00d8ff :
        root.accent-palette == "emerald" ? #00e676 :
        root.accent-palette == "violet" ? #b356ff :
        root.accent-palette == "amber" ? #ffab00 :
        #f05a46; // Coral Neon (default dal mockup)

    property <color> accent-soft:
        root.accent-palette == "cyan" ? #00d8ff33 :
        root.accent-palette == "emerald" ? #00e67633 :
        root.accent-palette == "violet" ? #b356ff33 :
        root.accent-palette == "amber" ? #ffab0033 :
        #f05a4638;

    property <UiMonitor> current-monitor: root.monitors.length > 0
        ? root.monitors[Math.clamp(root.selected-monitor-index, 0, root.monitors.length - 1)]
        : {
            id: 0, name: "Monitor", brand: "Generic", resolution: "1920×1080",
            is-primary: true, ddc-supported: false, is-internal-wmi: false,
            brightness: 50, brightness-max: 100, brightness-sup: true,
            contrast: 50, contrast-max: 100, contrast-sup: true,
            sharpness: 50, sharpness-max: 100, sharpness-sup: true,
            saturation: 50, saturation-max: 100, saturation-sup: true,
            red-gain: 50, green-gain: 50, blue-gain: 50, rgb-sup: true,
            color-temp: 5, color-temp-sup: true,
            volume: 50, volume-sup: true,
            input-source: 15, input-sup: true,
        };

    property <string> active-input-label:
        root.current-monitor.input-source == 15 ? "DisplayPort 1" :
        root.current-monitor.input-source == 16 ? "DisplayPort 2" :
        root.current-monitor.input-source == 17 ? "HDMI 1" :
        root.current-monitor.input-source == 18 ? "HDMI 2" :
        root.current-monitor.input-source == 27 ? "USB-C" : "DisplayPort 1";

    // Contenitore principale con angoli arrotondati standard Windows
    main-container := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.window-maximized ? 0px : 8px;
        clip: true;
        background: transparent;
        border-width: root.window-maximized ? 0px : 1px;
        border-color: #2c313d;

        HorizontalLayout {
            spacing: 0px;

            // ================================================================
            // 1. SIDEBAR SINISTRA (Vetro Satinato Windows Acrylic come nel Mockup)
            // ================================================================
            Rectangle {
                width: 248px;
                clip: true;
                background: root.acrylic-enabled ? #14182182 : #20242e;

                // Sottile riflesso superiore di profondità vetro
                if root.acrylic-enabled : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: #ffffff14;
                }

                // Bordo verticale destro di separazione
                Rectangle {
                    x: parent.width - 1px;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: root.acrylic-enabled ? #ffffff18 : #2e3340;
                }

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;

                    // Header App: Icona Monitor + "Monitor Manager" (trascinabile con WindowMoveArea nativo Slint)
                    Rectangle {
                        height: 34px;
                        background: transparent;

                        WindowMoveArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            // Icona monitor vettoriale fedele al mockup (schermo + piedistallo)
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                background: transparent;

                                // Schermo
                                Rectangle {
                                    x: 1px;
                                    y: 1px;
                                    width: 20px;
                                    height: 14px;
                                    border-radius: 3px;
                                    border-width: 1.5px;
                                    border-color: #4aa3df;
                                    background: #151b26;

                                    // Display interno attivo
                                    Rectangle {
                                        x: 2px;
                                        y: 2px;
                                        width: 13px;
                                        height: 7px;
                                        border-radius: 1px;
                                        background: @linear-gradient(135deg, #3ea8ff 0%, #1565c0 100%);
                                    }
                                }

                                // Gambo piedistallo
                                Rectangle {
                                    x: 9.5px;
                                    y: 15px;
                                    width: 3px;
                                    height: 3px;
                                    background: #4aa3df;
                                }

                                // Base piedistallo
                                Rectangle {
                                    x: 5px;
                                    y: 18px;
                                    width: 12px;
                                    height: 2px;
                                    border-radius: 1px;
                                    background: #4aa3df;
                                }
                            }

                            // Titolo tipografico pulito (senza badge ingombranti)
                            Text {
                                text: "Monitor Manager";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Spazio prima del menu
                    Rectangle { height: 4px; background: transparent; }

                    // --- VOCE HOME IN CIMA (Panoramica Rapida a Blocchi) ---
                    Rectangle {
                        height: 40px;
                        border-radius: 9px;
                        background: root.active-view == "home" ? #2f3441 : (home-ta.has-hover ? #252a36 : transparent);
                        border-width: root.active-view == "home" ? 1px : (home-ta.has-hover ? 1px : 0px);
                        border-color: root.active-view == "home" ? root.accent-main.with-alpha(0.5) : (home-ta.has-hover ? root.accent-main.with-alpha(0.25) : transparent);

                        animate background, border-color {
                            duration: SpringTheme.animations-enabled ? 180ms : 0ms;
                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                        }

                        home-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.active-view = "home"; }
                        }

                        if root.active-view == "home" : Rectangle {
                            x: 0px;
                            y: 10px;
                            width: 3px;
                            height: 20px;
                            border-radius: 1.5px;
                            background: root.accent-main;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;

                            HomeGlyph {
                                y: (parent.height - self.height) / 2;
                                icon-color: root.active-view == "home" ? root.accent-main : #9da5b4;
                            }
                            Text {
                                text: root.is-en ? "Home · Overview" : "Home · Panoramica";
                                color: root.active-view == "home" ? #ffffff : #c3c9d5;
                                font-size: 13px;
                                font-weight: root.active-view == "home" ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Intestazione sezione monitor
                    Rectangle {
                        height: 18px;
                        background: transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            Text {
                                text: root.is-en ? "DISPLAYS" : "MONITOR COLLEGATI";
                                color: #6f788a;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // --- LISTA MONITOR HARDWARE COLLEGATI (con Accordion per Monitor Attivo) ---
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            for mon[idx] in root.monitors : mon-entry := VerticalLayout {
                                spacing: 3px;
                                property <bool> is-mon-active: idx == root.selected-monitor-index && (root.active-view == "dashboard" || root.active-view == "profiles");

                                mon-card := Rectangle {
                                    height: 44px;
                                    border-radius: 10px;
                                    background: transparent;

                                    mon-ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected-monitor-index = idx;
                                            root.sync-current-values();
                                            if (root.active-view != "profiles") {
                                                root.active-view = "dashboard";
                                            }
                                        }
                                    }

                                    // Card interna del monitor con hover & selezione animata a molla
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border-radius: 9px;
                                        background: mon-entry.is-mon-active ? #2b303c : (mon-ta.has-hover ? #222631 : transparent);
                                        border-width: mon-entry.is-mon-active ? 1.5px : (mon-ta.has-hover ? 1px : 0px);
                                        border-color: mon-entry.is-mon-active ? root.accent-main : (mon-ta.has-hover ? root.accent-main.with-alpha(0.35) : transparent);

                                        animate background, border-color {
                                            duration: SpringTheme.animations-enabled ? 180ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 10px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                DisplayGlyph {
                                                    y: (parent.height - self.height) / 2;
                                                    is-laptop: mon.is-internal-wmi;
                                                    icon-color: mon-entry.is-mon-active ? #ffffff : #9da5b4;
                                                }

                                                Text {
                                                    text: mon.name;
                                                    color: mon-entry.is-mon-active ? #ffffff : #c3c9d5;
                                                    font-size: 12.5px;
                                                    font-weight: mon-entry.is-mon-active ? 600 : 500;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Pallino LED attivo a destra
                                            if mon-entry.is-mon-active : Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                background: root.accent-main;
                                            }
                                        }
                                    }
                                }

                                // --- SOTTO-ELENCO ACCORDION (Dashboard & Profili Colore) CON APERTURA A MOLLA ---
                                accordion-box := Rectangle {
                                    clip: true;
                                    height: mon-entry.is-mon-active ? 72px : 0px;
                                    opacity: mon-entry.is-mon-active ? 1.0 : 0.0;

                                    animate height {
                                        duration: SpringTheme.animations-enabled ? 240ms : 0ms;
                                        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                    }
                                    animate opacity {
                                        duration: SpringTheme.animations-enabled ? 200ms : 0ms;
                                        easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                    }

                                    VerticalLayout {
                                        padding-left: 18px;
                                        padding-right: 4px;
                                        spacing: 4px;

                                        // Sotto-voce 1: Dashboard
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 6px;
                                            background: root.active-view == "dashboard" ? root.accent-main.with-alpha(0.20) : (dash-ta.has-hover ? #282d38 : #21252e);
                                            border-width: 1px;
                                            border-color: root.active-view == "dashboard" ? root.accent-main : (dash-ta.has-hover ? root.accent-main.with-alpha(0.3) : #2d323e);

                                            animate background, border-color {
                                                duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;

                                                DashboardGlyph {
                                                    y: (parent.height - self.height) / 2;
                                                    icon-color: root.active-view == "dashboard" ? root.accent-main : #9da5b4;
                                                }
                                                Text {
                                                    text: "Dashboard";
                                                    color: root.active-view == "dashboard" ? #ffffff : #c3c9d5;
                                                    font-size: 12px;
                                                    font-weight: root.active-view == "dashboard" ? 600 : 500;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            dash-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.active-view = "dashboard"; }
                                            }
                                        }

                                        // Sotto-voce 2: Profili Colore
                                        Rectangle {
                                            height: 32px;
                                            border-radius: 6px;
                                            background: root.active-view == "profiles" ? root.accent-main.with-alpha(0.20) : (prof-ta.has-hover ? #282d38 : #21252e);
                                            border-width: 1px;
                                            border-color: root.active-view == "profiles" ? root.accent-main : (prof-ta.has-hover ? root.accent-main.with-alpha(0.3) : #2d323e);

                                            animate background, border-color {
                                                duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                                easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;

                                                ProfileGlyph {
                                                    y: (parent.height - self.height) / 2;
                                                    icon-color: root.active-view == "profiles" ? root.accent-main : #9da5b4;
                                                }
                                                Text {
                                                    text: root.is-en ? "Color Profiles" : "Profili Colore";
                                                    color: root.active-view == "profiles" ? #ffffff : #c3c9d5;
                                                    font-size: 12px;
                                                    font-weight: root.active-view == "profiles" ? 600 : 500;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            prof-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.active-view = "profiles"; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Separatore sottile
                            Rectangle {
                                height: 12px;
                                background: transparent;
                                Rectangle {
                                    y: 6px;
                                    height: 1px;
                                    width: 100%;
                                    background: #323744;
                                }
                            }

                            // Voce rapida: Ordina Monitor (Gestione Ordine)
                            Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: root.active-view == "reorder" ? #2f3441 : (reorder-ta.has-hover ? #242833 : transparent);
                                border-width: root.active-view == "reorder" ? 1px : (reorder-ta.has-hover ? 1px : 0px);
                                border-color: root.active-view == "reorder" ? root.accent-main : (reorder-ta.has-hover ? root.accent-main.with-alpha(0.3) : transparent);

                                animate background, border-color {
                                    duration: SpringTheme.animations-enabled ? 180ms : 0ms;
                                    easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                }

                                reorder-ta := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: pointer;
                                    clicked => { root.active-view = "reorder"; }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    alignment: start;

                                    ReorderGlyph {
                                        y: (parent.height - self.height) / 2;
                                        icon-color: root.active-view == "reorder" ? root.accent-main : #9da5b4;
                                    }
                                    Text {
                                        text: root.is-en ? "Reorder Displays" : "Ordina Monitor";
                                        color: root.active-view == "reorder" ? #ffffff : #c3c9d5;
                                        font-size: 12.5px;
                                        font-weight: root.active-view == "reorder" ? 600 : 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Separatore sopra il menu inferiore
                    Rectangle {
                        height: 1px;
                        background: #323744;
                    }

                    // --- MENU INFERIORE (Solo Impostazioni) ---
                    Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: root.active-view == "settings" ? #313643 : (settings-ta.has-hover ? #252a36 : transparent);
                        border-width: root.active-view == "settings" ? 1px : (settings-ta.has-hover ? 1px : 0px);
                        border-color: root.active-view == "settings" ? root.accent-main.with-alpha(0.5) : (settings-ta.has-hover ? root.accent-main.with-alpha(0.3) : transparent);

                        animate background, border-color {
                            duration: SpringTheme.animations-enabled ? 180ms : 0ms;
                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                        }

                        settings-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.active-view = "settings"; }
                        }

                        if root.active-view == "settings" : Rectangle {
                            x: 0px;
                            y: 10px;
                            width: 3px;
                            height: 20px;
                            border-radius: 1.5px;
                            background: root.accent-main;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: start;
                            SettingsGlyph {
                                y: (parent.height - self.height) / 2;
                                icon-color: root.active-view == "settings" ? root.accent-main : #9da5b4;
                            }
                            Text {
                                text: root.is-en ? "Settings" : "Impostazioni";
                                color: root.active-view == "settings" ? #ffffff : #c3c9d5;
                                font-size: 13px;
                                font-weight: root.active-view == "settings" ? 600 : 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ================================================================
            // 2. AREA PRINCIPALE DESTRA (Dark Matte Canvas + Top Window Bar)
            // ================================================================
            Rectangle {
                horizontal-stretch: 1;
                background: #171a21;

                VerticalLayout {
                    spacing: 0px;

                    // --- BARRA SUPERIORE BORDERLESS CON TRASCINAMENTO NATIVO SLINT ---
                    Rectangle {
                        height: 34px;
                        background: transparent;

                        // Area di trascinamento finestra nativa Slint (zero deadlock Win32)
                        WindowMoveArea {
                            width: 100%;
                            height: 100%;
                        }

                        HorizontalLayout {
                            padding-left: 22px;
                            padding-right: 0px;
                            spacing: 0px;

                            // Zona comandi rapidi header
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                HorizontalLayout {
                                    alignment: start;
                                    if root.update-available || root.update-downloading || root.update-installing : Rectangle {
                                        height: 22px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        clip: true;
                                        background: root.accent-main.with-alpha(root.update-downloading || root.update-installing ? 0.28 : 0.22);
                                        border-width: 1px;
                                        border-color: root.accent-main;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.update-installing
                                                    ? (root.is-en ? "Installing v\{root.latest-version}..." : "Installazione v\{root.latest-version}...")
                                                    : (root.update-downloading
                                                        ? (root.update-indeterminate
                                                            ? (root.is-en ? "Downloading v\{root.latest-version}..." : "Download v\{root.latest-version}...")
                                                            : (root.is-en ? "Downloading v\{root.latest-version} · \{Math.round(root.update-progress * 100)}%" : "Download v\{root.latest-version} · \{Math.round(root.update-progress * 100)}%"))
                                                        : (root.is-en ? "Update v\{root.latest-version} ready" : "Aggiornamento v\{root.latest-version} pronto"));
                                                color: #ffffff;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                        if root.update-downloading || root.update-installing : Rectangle {
                                            y: parent.height - 2px;
                                            height: 2px;
                                            x: root.update-installing ? 0px : (root.update-indeterminate ? parent.width * 0.25 : 0px);
                                            width: root.update-installing
                                                ? parent.width
                                                : (root.update-indeterminate
                                                    ? parent.width * 0.5
                                                    : parent.width * Math.clamp(root.update-progress, 0.0, 1.0));
                                            background: root.accent-main;
                                            animate width {
                                                duration: SpringTheme.animations-enabled ? 140ms : 0ms;
                                                easing: ease-out;
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if root.update-downloading || root.update-installing {
                                                    root.active-view = "settings";
                                                } else {
                                                    root.install-update();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Blocco Tasti Finestra integrato a filo nell'angolo in alto a destra (stile Mockup)
                            Rectangle {
                                width: 120px;
                                height: 34px;
                                y: 0px;
                                border-bottom-left-radius: 10px;
                                background: root.accent-main;

                                HorizontalLayout {
                                    spacing: 0px;

                                    // Riduci a icona (trattino bianco)
                                    min-btn := Rectangle {
                                        horizontal-stretch: 1;
                                        background: min-ta.has-hover ? #00000028 : transparent;
                                        border-bottom-left-radius: 10px;

                                        animate background {
                                            duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }

                                        Rectangle {
                                            width: 10px;
                                            height: 2px;
                                            border-radius: 1px;
                                            background: #ffffff;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        min-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.minimize-window(); }
                                        }
                                    }

                                    // Ingrandisci / Ripristina (quadratino bianco)
                                    max-btn := Rectangle {
                                        horizontal-stretch: 1;
                                        background: max-ta.has-hover ? #00000028 : transparent;

                                        animate background {
                                            duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }

                                        Rectangle {
                                            width: 9px;
                                            height: 9px;
                                            border-width: 1.6px;
                                            border-color: #ffffff;
                                            border-radius: 1.5px;
                                            background: transparent;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        max-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-maximize-window(); }
                                        }
                                    }

                                    // Chiudi / System Tray (X bianca vettoriale con hover rosso scuro)
                                    cls-btn := Rectangle {
                                        horizontal-stretch: 1;
                                        background: cls-ta.has-hover ? #c5221f : transparent;

                                        animate background {
                                            duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }

                                        Path {
                                            width: 9px;
                                            height: 9px;
                                            stroke: #ffffff;
                                            stroke-width: 1.8px;
                                            stroke-line-cap: round;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            MoveTo { x: 0; y: 0; }
                                            LineTo { x: 9; y: 9; }
                                            MoveTo { x: 9; y: 0; }
                                            LineTo { x: 0; y: 9; }
                                        }

                                        cls-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.close-window(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- CONTENUTO PRINCIPALE SCORREVOLE ---
                    sv := ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            width: Math.max(self.min-width, sv.visible-width);
                            alignment: start;

                            HorizontalLayout {
                                alignment: center;

                                VerticalLayout {
                                    width: Math.min(1084px, Math.max(504px, sv.visible-width));
                                    padding-left: 22px;
                                    padding-right: 22px;
                                    padding-top: root.is-compact ? 10px : 14px;
                                    padding-bottom: 24px;
                                    spacing: root.is-compact ? 12px : 16px;
                                    alignment: start;

                            // ========================================================
                            // VISTA 0: HOME — PANORAMICA RAPIDA A GRIGLIA ADATTIVA (2 COLONNE)
                            // ========================================================
                            if root.active-view == "home" : VerticalLayout {
                                spacing: 16px;

                                // Header Sezione Home
                                Rectangle {
                                    height: 58px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: root.is-en ? "Displays Overview · Quick Controls" : "Panoramica Display · Controlli Rapidi";
                                                color: #ffffff;
                                                font-size: 16px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: root.is-en
                                                    ? "Adjust brightness & contrast instantly across desktop DDC/CI and laptop WMI screens."
                                                    : "Regola al volo luminosità e contrasto di monitor DDC/CI esterni e schermi laptop WMI.";
                                                color: #9da5b4;
                                                font-size: 11px;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            TitaniumChip {
                                                text: root.sync-monitors
                                                    ? (root.is-en ? "Sync Active" : "Sync Attivo")
                                                    : (root.is-en ? "Sync All" : "Sincronizza Tutti");
                                                active: root.sync-monitors;
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.sync-monitors = !root.sync-monitors;
                                                    root.save-settings();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Griglia adattiva a coppie (2 colonne per riga, zero overflow con 1..10 schermi)
                                VerticalLayout {
                                    spacing: 0px;

                                    for row-idx in [0, 1, 2, 3, 4] : VerticalLayout {
                                        padding-top: (row-idx > 0 && (row-idx * 2) < root.monitors.length) ? 14px : 0px;

                                        if (row-idx * 2) < root.monitors.length : HorizontalLayout {
                                            spacing: 14px;

                                            HomeMonitorCard {
                                                horizontal-stretch: 1;
                                                mon: root.monitors[row-idx * 2];
                                                mon-index: row-idx * 2;
                                                accent-main: root.accent-main;
                                                glow-style: root.glow-style;
                                                is-en: root.is-en;
                                                hide-unsupported: root.hide-unsupported;
                                                set-vcp(id, code, val) => { root.set-vcp(id, code, val); }
                                                open-details(idx) => {
                                                    root.selected-monitor-index = idx;
                                                    root.sync-current-values();
                                                    root.active-view = "dashboard";
                                                }
                                            }

                                            if (row-idx * 2 + 1) < root.monitors.length : HomeMonitorCard {
                                                horizontal-stretch: 1;
                                                mon: root.monitors[row-idx * 2 + 1];
                                                mon-index: row-idx * 2 + 1;
                                                accent-main: root.accent-main;
                                                glow-style: root.glow-style;
                                                is-en: root.is-en;
                                                hide-unsupported: root.hide-unsupported;
                                                set-vcp(id, code, val) => { root.set-vcp(id, code, val); }
                                                open-details(idx) => {
                                                    root.selected-monitor-index = idx;
                                                    root.sync-current-values();
                                                    root.active-view = "dashboard";
                                                }
                                            }

                                            if root.monitors.length > 1 && (row-idx * 2 + 1) >= root.monitors.length : Rectangle {
                                                horizontal-stretch: 1;
                                                background: transparent;
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 1: DASHBOARD PRINCIPALE (Hero + Quartetto + Guadagno RGB)
                            // ========================================================
                            if root.active-view == "dashboard" : VerticalLayout {
                                spacing: root.is-compact ? 12px : 16px;

                                // 1. HERO HEADER CARD (Monitor Name, Status Badge, Spec Chip, SVG Arc Gauge)
                                Rectangle {
                                    height: root.is-compact ? 132px : 148px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    HorizontalLayout {
                                        padding-left: 24px;
                                        padding-right: 28px;
                                        padding-top: 16px;
                                        padding-bottom: 16px;
                                        alignment: space-between;

                                        // Colonna Sinistra: Nome Monitor + Badge Hardware + Risoluzione/Hz/Input
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 10px;

                                            Text {
                                                text: root.current-monitor.name;
                                                color: #f3f5f9;
                                                font-size: root.is-compact ? 22px : 26px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }

                                            // Pill stato connessione hardware
                                            HorizontalLayout {
                                                alignment: start;
                                                Rectangle {
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: #2a2f3b;
                                                    border-width: 1px;
                                                    border-color: #363c4a;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        spacing: 8px;
                                                        alignment: center;

                                                        Rectangle {
                                                            width: 8px;
                                                            height: 8px;
                                                            y: (parent.height - self.height) / 2;
                                                            border-radius: 4px;
                                                            background: root.current-monitor.ddc-supported ? #39d353 : (root.current-monitor.is-internal-wmi ? #38bdf8 : #f59e0b);
                                                        }

                                                        Text {
                                                            text: root.current-monitor.ddc-supported
                                                                ? (root.is-en ? "DDC/CI Active" : "DDC/CI Attivo")
                                                                : (root.current-monitor.is-internal-wmi
                                                                    ? (root.is-en ? "Internal WMI" : "WMI Integrato")
                                                                    : (root.is-en ? "Read-Only" : "Solo Lettura"));
                                                            color: #dcdfe6;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Pill Risoluzione | Refresh (| Input se supportato)
                                            HorizontalLayout {
                                                alignment: start;
                                                Rectangle {
                                                    height: 28px;
                                                    border-radius: 6px;
                                                    background: #282c37;
                                                    border-width: 1px;
                                                    border-color: #343947;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 12px;
                                                        alignment: center;
                                                        Text {
                                                            text: root.current-monitor.input-sup
                                                                ? "\{root.current-monitor.resolution} | \{root.active-input-label}"
                                                                : root.current-monitor.resolution;
                                                            color: #c5cbd6;
                                                            font-size: 12.5px;
                                                            font-weight: 500;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Colonna Destra: Circular SVG Arc Gauge 260°
                                        VerticalLayout {
                                            alignment: center;
                                            ArcGauge {
                                                percentage: Math.round(root.current-brightness * 100 / Math.max(1, root.current-monitor.brightness-max));
                                                label: root.is-en ? "Brightness" : "Luminosità";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                adjusted(v) => {
                                                    if (root.current-monitor.brightness-sup) {
                                                        root.set-vcp(root.current-monitor.id, 16, Math.round(v * root.current-monitor.brightness-max / 100));
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 2. QUARTETTO STAT CARDS (filtrabile tramite hide-unsupported)
                                if !root.hide-unsupported
                                    || root.current-monitor.brightness-sup
                                    || root.current-monitor.contrast-sup
                                    || root.current-monitor.sharpness-sup
                                    || root.current-monitor.saturation-sup : HorizontalLayout {
                                    spacing: root.is-compact ? 10px : 14px;

                                    if !root.hide-unsupported || root.current-monitor.brightness-sup : TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Brightness:" : "Luminosità:";
                                        value <=> root.current-brightness;
                                        maximum: root.current-monitor.brightness-max;
                                        supported: root.current-monitor.brightness-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 16, v); }
                                    }

                                    if !root.hide-unsupported || root.current-monitor.contrast-sup : TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Contrast:" : "Contrasto:";
                                        value <=> root.current-contrast;
                                        maximum: root.current-monitor.contrast-max;
                                        supported: root.current-monitor.contrast-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 18, v); }
                                    }

                                    if !root.hide-unsupported || root.current-monitor.sharpness-sup : TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Sharpness:" : "Nitidezza:";
                                        value <=> root.current-sharpness;
                                        maximum: root.current-monitor.sharpness-max;
                                        supported: root.current-monitor.sharpness-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 135, v); }
                                    }

                                    if !root.hide-unsupported || root.current-monitor.saturation-sup : TitaniumStatCard {
                                        horizontal-stretch: 1;
                                        title: root.is-en ? "Saturation:" : "Saturazione:";
                                        value <=> root.current-saturation;
                                        maximum: root.current-monitor.saturation-max;
                                        supported: root.current-monitor.saturation-sup;
                                        accent: root.accent-main;
                                        glow-style: root.glow-style;
                                        compact: root.is-compact;
                                        changed(v) => { root.set-vcp(root.current-monitor.id, 138, v); }
                                    }
                                }

                                // 3. CARD RGB GAIN (Red, Green, Blue)
                                if !root.hide-unsupported || root.current-monitor.rgb-sup : Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding-left: 22px;
                                        padding-right: 22px;
                                        padding-top: root.is-compact ? 14px : 18px;
                                        padding-bottom: root.is-compact ? 14px : 18px;
                                        spacing: root.is-compact ? 10px : 14px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en ? "RGB Gain" : "Guadagno RGB";
                                                color: #e9edf5;
                                                font-size: 14px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }

                                            // Pulsante rapido Reset RGB 50%
                                            Rectangle {
                                                height: 26px;
                                                border-radius: 6px;
                                                background: reset-rgb-ta.has-hover ? #343b4a : #2a2f3b;
                                                border-width: 1px;
                                                border-color: reset-rgb-ta.has-hover ? root.accent-main.with-alpha(0.5) : #363c4a;

                                                animate background, border-color {
                                                    duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                                    easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                                }

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    Text {
                                                        text: root.is-en ? "Reset 50%" : "Ripristina 50%";
                                                        color: reset-rgb-ta.has-hover ? #ffffff : #b8bfcc;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                reset-rgb-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    enabled: root.current-monitor.rgb-sup;
                                                    clicked => {
                                                        root.current-red-gain = 50;
                                                        root.current-green-gain = 50;
                                                        root.current-blue-gain = 50;
                                                        root.reset-rgb(root.current-monitor.id);
                                                    }
                                                }
                                            }
                                        }

                                        // Canale RED
                                        HorizontalLayout {
                                            spacing: 12px;
                                            HorizontalLayout {
                                                width: 72px;
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: #e85642;
                                                }
                                                Text {
                                                    text: root.is-en ? "Red" : "Rosso";
                                                    color: #c5cbd6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            NeonSlider {
                                                horizontal-stretch: 1;
                                                value <=> root.current-red-gain;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: #e85642;
                                                glow-style: root.glow-style;
                                                enabled: root.current-monitor.rgb-sup;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 22, v); }
                                            }
                                            Text {
                                                width: 38px;
                                                text: "\{root.current-red-gain}%";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Canale GREEN
                                        HorizontalLayout {
                                            spacing: 12px;
                                            HorizontalLayout {
                                                width: 72px;
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: #46b966;
                                                }
                                                Text {
                                                    text: root.is-en ? "Green" : "Verde";
                                                    color: #c5cbd6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            NeonSlider {
                                                horizontal-stretch: 1;
                                                value <=> root.current-green-gain;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: #46b966;
                                                glow-style: root.glow-style;
                                                enabled: root.current-monitor.rgb-sup;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 24, v); }
                                            }
                                            Text {
                                                width: 38px;
                                                text: "\{root.current-green-gain}%";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Canale BLUE
                                        HorizontalLayout {
                                            spacing: 12px;
                                            HorizontalLayout {
                                                width: 72px;
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px;
                                                    background: #4a7ee5;
                                                }
                                                Text {
                                                    text: root.is-en ? "Blue" : "Blu";
                                                    color: #c5cbd6;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            NeonSlider {
                                                horizontal-stretch: 1;
                                                value <=> root.current-blue-gain;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: #4a7ee5;
                                                glow-style: root.glow-style;
                                                enabled: root.current-monitor.rgb-sup;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 26, v); }
                                            }
                                            Text {
                                                width: 38px;
                                                text: "\{root.current-blue-gain}%";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                font-weight: 600;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 2: PROFILI COLORE, TEMPERATURA, AUDIO & INPUT
                            // ========================================================
                            if root.active-view == "profiles" : VerticalLayout {
                                spacing: 14px;

                                // Header + Preset Rapidi + Temperatura Colore
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        Text {
                                            text: root.is-en
                                                ? "Color Profiles & Quick Presets — \{root.current-monitor.name}"
                                                : "Profili Colore & Preset Rapidi — \{root.current-monitor.name}";
                                            color: #f3f5f9;
                                            font-size: 16px;
                                            font-weight: 700;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Gaming Vivid (90/75)" : "Gaming Vivace (90/75)";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.current-brightness = 90;
                                                    if (root.current-monitor.contrast-sup) {
                                                        root.current-contrast = 75;
                                                    }
                                                    root.apply-preset(root.current-monitor.id, 90, 75);
                                                }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Standard sRGB (75/50)" : "Standard sRGB (75/50)";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.current-brightness = 75;
                                                    if (root.current-monitor.contrast-sup) {
                                                        root.current-contrast = 50;
                                                    }
                                                    root.apply-preset(root.current-monitor.id, 75, 50);
                                                }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Eye Care Night (35/45)" : "Comfort Notturno (35/45)";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => {
                                                    root.current-brightness = 35;
                                                    if (root.current-monitor.contrast-sup) {
                                                        root.current-contrast = 45;
                                                    }
                                                    root.apply-preset(root.current-monitor.id, 35, 45);
                                                }
                                            }
                                        }

                                        if !root.hide-unsupported || root.current-monitor.color-temp-sup : VerticalLayout {
                                            spacing: 10px;

                                            Text {
                                                text: root.is-en ? "Color Temperature (VCP 0x14)" : "Temperatura Colore (VCP 0x14)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: root.is-en ? "5000K Warm" : "5000K Caldo";
                                                    active: root.current-monitor.color-temp == 4;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 20, 4); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: "6500K Standard";
                                                    active: root.current-monitor.color-temp == 5;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 20, 5); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: root.is-en ? "9300K Cool" : "9300K Freddo";
                                                    active: root.current-monitor.color-temp == 8;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 20, 8); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: root.is-en ? "User RGB" : "Utente RGB";
                                                    active: root.current-monitor.color-temp == 11;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 20, 11); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card Audio Volume & Video Input Source
                                if !root.hide-unsupported || root.current-monitor.volume-sup || root.current-monitor.input-sup : Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        if !root.hide-unsupported || root.current-monitor.volume-sup : VerticalLayout {
                                            spacing: 10px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: root.is-en ? "Speaker Volume (VCP 0x62)" : "Volume Altoparlanti (VCP 0x62)";
                                                    color: #e9edf5;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.current-monitor.volume-sup ? "\{root.current-volume}%" : "--";
                                                    color: root.accent-main;
                                                    font-size: 14px;
                                                    font-weight: 700;
                                                }
                                            }

                                            NeonSlider {
                                                value <=> root.current-volume;
                                                minimum: 0;
                                                maximum: 100;
                                                track-color: root.accent-main;
                                                glow-style: root.glow-style;
                                                enabled: root.current-monitor.volume-sup;
                                                changed(v) => { root.set-vcp(root.current-monitor.id, 98, v); }
                                            }
                                        }

                                        if !root.hide-unsupported || root.current-monitor.input-sup : VerticalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: root.is-en ? "Video Input Source (VCP 0x60)" : "Sorgente Input Video (VCP 0x60)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: "DisplayPort 1";
                                                    active: root.current-monitor.input-source == 15;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 96, 15); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: "DisplayPort 2";
                                                    active: root.current-monitor.input-source == 16;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 96, 16); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: "HDMI 1";
                                                    active: root.current-monitor.input-source == 17;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 96, 17); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: "HDMI 2";
                                                    active: root.current-monitor.input-source == 18;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 96, 18); }
                                                }
                                                TitaniumChip {
                                                    horizontal-stretch: 1;
                                                    text: "USB-C";
                                                    active: root.current-monitor.input-source == 27;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.set-vcp(root.current-monitor.id, 96, 27); }
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.hide-unsupported && !root.current-monitor.volume-sup && !root.current-monitor.input-sup : Rectangle {
                                    height: 54px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;
                                    Text {
                                        text: root.is-en
                                            ? "Audio volume & video input switching are hidden because this panel does not expose them via DDC/CI."
                                            : "Volume altoparlanti e cambio ingresso video sono nascosti perché questo display non li espone via DDC/CI.";
                                        color: #9da5b4;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 3: ORDINA MONITOR (Gestione Ordine & Priorità)
                            // ========================================================
                            // VISTA 3: ORDINA MONITOR (Drag-and-Drop continuo su lista a passo fisso)
                            // ========================================================
                            if root.active-view == "reorder" : VerticalLayout {
                                spacing: 14px;

                                Rectangle {
                                    height: 58px;
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: space-between;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: root.is-en ? "Displays Order · Priority Setup" : "Ordinamento & Priorità Monitor";
                                                color: #ffffff;
                                                font-size: 16px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: root.is-en
                                                    ? "Press and drag any display card up or down to set priority across the sidebar and Home."
                                                    : "Tieni premuta una card display e trascinala su o giù per aggiornare subito sidebar e Home.";
                                                color: #9da5b4;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }

                                reorder-list := Rectangle {
                                    height: root.monitors.length * 68px + Math.max(0, root.monitors.length - 1) * 10px;
                                    background: transparent;

                                    property <int> dragging-row: -1;
                                    property <int> target-row: -1;
                                    property <bool> dragging-active: false;
                                    property <bool> drop-settling: false;
                                    property <bool> suppress-slot-anim: false;
                                    property <length> grab-offset-y: 34px;
                                    property <length> drag-y: 0px;
                                    property <int> hovered-row: drag-overlay.has-hover && !dragging-active && !drop-settling && root.monitors.length > 0
                                        ? Math.clamp(Math.floor(drag-overlay.mouse-y / 78px), 0, root.monitors.length - 1)
                                        : -1;

                                    reset-anim-timer := Timer {
                                        interval: 24ms;
                                        running: false;
                                        triggered => {
                                            self.running = false;
                                            reorder-list.suppress-slot-anim = false;
                                        }
                                    }

                                    settle-timer := Timer {
                                        interval: SpringTheme.animations-enabled ? 195ms : 1ms;
                                        running: false;
                                        triggered => {
                                            self.running = false;
                                            reorder-list.suppress-slot-anim = true;
                                            if (reorder-list.dragging-row >= 0 && reorder-list.target-row >= 0 && reorder-list.dragging-row != reorder-list.target-row) {
                                                root.move-monitor(reorder-list.dragging-row, reorder-list.target-row);
                                            }
                                            reorder-list.dragging-row = -1;
                                            reorder-list.target-row = -1;
                                            reorder-list.drop-settling = false;
                                            reset-anim-timer.running = true;
                                        }
                                    }

                                    // Guida slot di destinazione durante il trascinamento
                                    if reorder-list.dragging-row >= 0 && reorder-list.target-row >= 0 : Rectangle {
                                        x: 0px;
                                        y: reorder-list.target-row * 78px;
                                        width: parent.width;
                                        height: 68px;
                                        border-radius: 12px;
                                        background: root.accent-main.with-alpha(0.07);
                                        border-width: 1.5px;
                                        border-color: root.accent-main.with-alpha(0.5);

                                        animate y {
                                            duration: (SpringTheme.animations-enabled && !reorder-list.suppress-slot-anim) ? 180ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }
                                    }

                                    // Card monitor stazionarie che scivolano fluidamente negli slot liberi
                                    for mon[m-idx] in root.monitors : ReorderCardRow {
                                        property <int> visual-slot: reorder-list.dragging-row < 0
                                            ? m-idx
                                            : (reorder-list.dragging-row < reorder-list.target-row
                                                ? (m-idx > reorder-list.dragging-row && m-idx <= reorder-list.target-row ? m-idx - 1 : m-idx)
                                                : (reorder-list.dragging-row > reorder-list.target-row
                                                    ? (m-idx >= reorder-list.target-row && m-idx < reorder-list.dragging-row ? m-idx + 1 : m-idx)
                                                    : m-idx));

                                        visible: m-idx != reorder-list.dragging-row;
                                        x: 0px;
                                        y: visual-slot * 78px;
                                        width: parent.width;
                                        mon: mon;
                                        rank: visual-slot + 1;
                                        accent-main: root.accent-main;
                                        is-en: root.is-en;
                                        is-hovered: reorder-list.dragging-row < 0 && reorder-list.hovered-row == m-idx;
                                        dimmed: reorder-list.dragging-active;

                                        animate y {
                                            duration: (SpringTheme.animations-enabled && !reorder-list.suppress-slot-anim) ? 220ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }
                                    }

                                    // Card attiva trascinata in primo piano con ombra e snap elastico al rilascio
                                    if reorder-list.dragging-row >= 0 && reorder-list.dragging-row < root.monitors.length : ReorderCardRow {
                                        x: -2px;
                                        y: reorder-list.dragging-active
                                            ? reorder-list.drag-y
                                            : reorder-list.target-row * 78px;
                                        width: parent.width + 4px;
                                        mon: root.monitors[Math.clamp(reorder-list.dragging-row, 0, Math.max(0, root.monitors.length - 1))];
                                        rank: Math.max(0, reorder-list.target-row) + 1;
                                        accent-main: root.accent-main;
                                        is-en: root.is-en;
                                        is-dragged: true;

                                        animate y {
                                            duration: (SpringTheme.animations-enabled && reorder-list.drop-settling) ? 190ms : 0ms;
                                            easing: cubic-bezier(0.34, 1.4, 0.64, 1);
                                        }
                                    }

                                    // Overlay unico per trascinamento continuo senza perdere la cattura del puntatore
                                    drag-overlay := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: reorder-list.dragging-active ? grabbing : (reorder-list.hovered-row >= 0 ? grab : default);

                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down && root.monitors.length > 0) {
                                                // Se un rilascio precedente sta ancora animando lo snap, consolida subito prima del nuovo drag
                                                if (reorder-list.drop-settling) {
                                                    settle-timer.running = false;
                                                    reorder-list.suppress-slot-anim = true;
                                                    if (reorder-list.dragging-row >= 0 && reorder-list.target-row >= 0 && reorder-list.dragging-row != reorder-list.target-row) {
                                                        root.move-monitor(reorder-list.dragging-row, reorder-list.target-row);
                                                    }
                                                    reorder-list.dragging-row = -1;
                                                    reorder-list.target-row = -1;
                                                    reorder-list.drop-settling = false;
                                                    reorder-list.suppress-slot-anim = false;
                                                }
                                                let picked = Math.clamp(Math.floor(self.pressed-y / 78px), 0, root.monitors.length - 1);
                                                reorder-list.grab-offset-y = Math.clamp(self.pressed-y - picked * 78px, 6px, 62px);
                                                reorder-list.drag-y = picked * 78px;
                                                reorder-list.dragging-row = picked;
                                                reorder-list.target-row = picked;
                                                reorder-list.dragging-active = true;
                                                reorder-list.drop-settling = false;
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                if (reorder-list.dragging-active) {
                                                    reorder-list.drop-settling = true;
                                                    reorder-list.dragging-active = false;
                                                    settle-timer.running = true;
                                                }
                                            }
                                        }

                                        moved => {
                                            if (self.pressed && reorder-list.dragging-active && root.monitors.length > 1) {
                                                let max-y = Math.max(0px, (root.monitors.length - 1) * 78px);
                                                let next-y = Math.clamp(self.mouse-y - reorder-list.grab-offset-y, -6px, max-y + 6px);
                                                reorder-list.drag-y = next-y;
                                                reorder-list.target-row = Math.clamp(
                                                    Math.floor((next-y + 34px) / 78px),
                                                    0,
                                                    root.monitors.length - 1
                                                );
                                            }
                                        }
                                    }
                                }
                            }

                            // ========================================================
                            // VISTA 4: IMPOSTAZIONI (Organizzate in 4 Card Tematiche)
                            // ========================================================
                            if root.active-view == "settings" : VerticalLayout {
                                spacing: 14px;

                                // CARD 1: SISTEMA & COMPORTAMENTO
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            CategoryBadge {
                                                accent: root.accent-main;
                                                kind: "system";
                                            }
                                            Text {
                                                text: root.is-en ? "System & Behavior" : "Sistema & Comportamento";
                                                color: #ffffff;
                                                font-size: 15px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Start automatically with Windows (minimized to System Tray)"
                                                    : "Avvia automaticamente all'avvio di Windows (in background)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.start-with-windows;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Minimize to System Tray on close (X) (~2-6 MB RAM in Gaming)"
                                                    : "Riduci nella System Tray alla chiusura (X) (~2-6 MB RAM)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.close-to-tray;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Synchronize adjustments across all connected displays"
                                                    : "Sincronizza le modifiche su tutti i monitor collegati (Sync All)";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.sync-monitors;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }
                                    }
                                }

                                // CARD 2: ASPETTO & PERSONALIZZAZIONE
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            CategoryBadge {
                                                accent: root.accent-main;
                                                kind: "style";
                                            }
                                            Text {
                                                text: root.is-en ? "Appearance & Accent Theme" : "Aspetto & Personalizzazione";
                                                color: #ffffff;
                                                font-size: 15px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Palette Colore d'Accento
                                        Text {
                                            text: root.is-en ? "Accent Color Palette" : "Palette Colore d'Accento";
                                            color: #9da5b4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            AccentSwatchChip {
                                                horizontal-stretch: 1;
                                                text: "Coral Neon";
                                                active: root.accent-palette == "coral";
                                                swatch-color: #f05a46;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "coral"; root.save-settings(); }
                                            }
                                            AccentSwatchChip {
                                                horizontal-stretch: 1;
                                                text: "Cyber Cyan";
                                                active: root.accent-palette == "cyan";
                                                swatch-color: #00d8ff;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "cyan"; root.save-settings(); }
                                            }
                                            AccentSwatchChip {
                                                horizontal-stretch: 1;
                                                text: "Emerald";
                                                active: root.accent-palette == "emerald";
                                                swatch-color: #00e676;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "emerald"; root.save-settings(); }
                                            }
                                            AccentSwatchChip {
                                                horizontal-stretch: 1;
                                                text: "Electric Violet";
                                                active: root.accent-palette == "violet";
                                                swatch-color: #b356ff;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "violet"; root.save-settings(); }
                                            }
                                            AccentSwatchChip {
                                                horizontal-stretch: 1;
                                                text: "Amber Gold";
                                                active: root.accent-palette == "amber";
                                                swatch-color: #ffab00;
                                                glow-style: root.glow-style;
                                                clicked => { root.accent-palette = "amber"; root.save-settings(); }
                                            }
                                        }

                                        // Densità Layout
                                        Text {
                                            text: root.is-en ? "Layout Density" : "Densità Spaziatura Layout";
                                            color: #9da5b4;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Comfort (Standard)" : "Comodo (Standard)";
                                                active: root.layout-density == "standard";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.layout-density = "standard"; root.save-settings(); }
                                            }
                                            TitaniumChip {
                                                horizontal-stretch: 1;
                                                text: root.is-en ? "Compact" : "Compatto";
                                                active: root.layout-density == "compact";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.layout-density = "compact"; root.save-settings(); }
                                            }
                                        }

                                        Rectangle { height: 1px; background: #2e3442; }

                                        // Toggle Trasparenza Windows Acrylic (DWM)
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: root.is-en ? "Windows Acrylic Transparency (DWM)" : "Trasparenza Windows Acrylic (DWM)";
                                                    color: #ffffff;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.is-en
                                                        ? "Real-time desktop frosted glass blur behind the sidebar"
                                                        : "Vera sfocatura vetro satinato del desktop dietro la sidebar";
                                                    color: #8c95a6;
                                                    font-size: 11px;
                                                }
                                            }
                                            TitaniumToggle {
                                                checked <=> root.acrylic-enabled;
                                                accent: root.accent-main;
                                                toggled(v) => { root.toggle-acrylic(v); }
                                            }
                                        }

                                        // Animazioni Fluide a Molla
                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: root.is-en ? "Fluid Spring Animations" : "Animazioni Fluide a Molla";
                                                    color: #ffffff;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.is-en
                                                        ? "Reactive spring bounce on sliders & cards (disable to save RAM & CPU)"
                                                        : "Transizioni e controlli elastici reattivi (disattiva per zero overhead)";
                                                    color: #8c95a6;
                                                    font-size: 11px;
                                                }
                                            }
                                            TitaniumToggle {
                                                checked <=> root.animations-enabled;
                                                accent: root.accent-main;
                                                toggled(v) => { root.save-settings(); }
                                            }
                                        }
                                    }
                                }

                                // CARD 3: HARDWARE DDC/CI & WMI + LINGUA
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            CategoryBadge {
                                                accent: root.accent-main;
                                                kind: "hardware";
                                            }
                                            Text {
                                                text: root.is-en ? "Hardware DDC/CI, WMI & Language" : "Hardware DDC/CI, WMI & Lingua";
                                                color: #ffffff;
                                                font-size: 15px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en ? "Interface Language" : "Lingua dell'Interfaccia";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                TitaniumChip {
                                                    text: "IT · Italiano";
                                                    active: root.lang == "it";
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.lang = "it"; root.save-settings(); }
                                                }
                                                TitaniumChip {
                                                    text: "EN · English";
                                                    active: root.lang == "en";
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.lang = "en"; root.save-settings(); }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Hide controls unsupported by display hardware"
                                                    : "Nascondi controlli non supportati dall'hardware";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.hide-unsupported;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Rescan display bus and re-detect hardware monitors"
                                                    : "Esegui una nuova scansione dei monitor collegati";
                                                color: #9da5b4;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumChip {
                                                text: root.is-en ? "Rescan Hardware Now" : "Rileva Monitor Ora";
                                                accent: root.accent-main;
                                                glow-style: root.glow-style;
                                                clicked => { root.rescan-monitors(); }
                                            }
                                        }
                                    }
                                }

                                // CARD 4: SOFTWARE & AGGIORNAMENTI GITHUB
                                Rectangle {
                                    border-radius: 12px;
                                    background: #21252e;
                                    border-width: 1px;
                                    border-color: #2d323e;

                                    VerticalLayout {
                                        padding: 20px;
                                        spacing: 14px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            CategoryBadge {
                                                accent: root.accent-main;
                                                kind: "updates";
                                            }
                                            Text {
                                                text: root.is-en ? "Software Updates & Info" : "Aggiornamenti Software & Info";
                                                color: #ffffff;
                                                font-size: 15px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: root.is-en
                                                    ? "Check for GitHub updates automatically on startup"
                                                    : "Controlla aggiornamenti GitHub automaticamente all'avvio";
                                                color: #c5cbd6;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                            TitaniumToggle {
                                                checked <=> root.auto-check-updates;
                                                accent: root.accent-main;
                                                toggled => { root.save-settings(); }
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: #2e3340;
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;
                                                Text {
                                                    text: root.update-status-text;
                                                    color: root.update-failed ? #ffb4a8 : #e9edf5;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: "Ultra-Lightweight Rust Engine · Slint Native UI";
                                                    color: #9da5b4;
                                                    font-size: 11px;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: center;

                                                TitaniumChip {
                                                    text: root.update-downloading
                                                        ? (root.is-en ? "Cancel" : "Annulla")
                                                        : (root.update-checking
                                                            ? (root.is-en ? "Checking..." : "Verifica...")
                                                            : (root.is-en ? "Check Updates" : "Verifica Aggiornamenti"));
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    subtle-danger: root.update-downloading;
                                                    enabled: root.update-downloading || (!root.update-checking && !root.update-installing);
                                                    clicked => {
                                                        if root.update-downloading {
                                                            root.cancel-update();
                                                        } else {
                                                            root.check-updates();
                                                        }
                                                    }
                                                }
                                                if root.update-available || root.update-downloading || root.update-installing : TitaniumChip {
                                                    text: root.update-installing
                                                        ? (root.is-en ? "Installing..." : "Installazione...")
                                                        : (root.update-downloading
                                                            ? (root.update-indeterminate
                                                                ? (root.is-en ? "Downloading..." : "Download...")
                                                                : (root.is-en ? "Download \{Math.round(root.update-progress * 100)}%..." : "Download \{Math.round(root.update-progress * 100)}%..."))
                                                            : (root.update-failed
                                                                ? (root.is-en ? "Retry Update" : "Riprova Aggiornamento")
                                                                : (root.is-en ? "Update Now" : "Aggiorna Ora")));
                                                    active: true;
                                                    enabled: !root.update-downloading && !root.update-installing;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.install-update(); }
                                                }
                                                TitaniumChip {
                                                    text: root.is-en ? "Quit App" : "Esci Completamente";
                                                    enabled: !root.update-installing;
                                                    accent: root.accent-main;
                                                    glow-style: root.glow-style;
                                                    clicked => { root.quit-app(); }
                                                }
                                            }
                                        }

                                        if root.update-downloading || root.update-installing : VerticalLayout {
                                            spacing: 6px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: root.update-progress-phase;
                                                    color: #dce1eb;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.update-progress-detail;
                                                    color: #9da5b4;
                                                    font-size: 11px;
                                                }
                                            }
                                            Rectangle {
                                                height: 6px;
                                                border-radius: 3px;
                                                background: #1a1e26;
                                                border-width: 1px;
                                                border-color: #2e3442;
                                                clip: true;

                                                Rectangle {
                                                    y: 0px;
                                                    height: parent.height;
                                                    border-radius: 3px;
                                                    x: root.update-installing
                                                        ? 0px
                                                        : (root.update-indeterminate ? parent.width * 0.275 : 0px);
                                                    width: root.update-installing
                                                        ? parent.width
                                                        : (root.update-indeterminate
                                                            ? parent.width * 0.45
                                                            : parent.width * Math.clamp(root.update-progress, 0.0, 1.0));
                                                    background: root.accent-main;
                                                    animate width {
                                                        duration: SpringTheme.animations-enabled ? 160ms : 0ms;
                                                        easing: ease-out;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// FINESTRA INSTALLER SETUP v1.14 (DARK MATTE TITANIUM & SPRING ANIMATIONS)
// ============================================================================
export component SetupWindow inherits Window {
    title: "Installazione Monitor Manager v1.14";
    preferred-width: 520px;
    preferred-height: 410px;
    background: transparent;

    in-out property <bool> opt-desktop: true;
    in-out property <bool> opt-start-menu: true;
    in-out property <bool> opt-autostart: false;
    in-out property <bool> opt-launch: true;
    in-out property <bool> installing: false;
    in-out property <bool> installed: false;
    in-out property <string> status-text: "Pronto per installare Monitor Manager v1.14 (Dark Matte Titanium & Acrylic)";
    in-out property <string> install-path: "";

    callback start-install();
    callback finish-setup();

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        clip: true;
        background: #171a21;
        border-width: 1px;
        border-color: #2c313d;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

        Rectangle {
            height: 76px;
            border-radius: 12px;
            background: #21252e;
            border-width: 1.5px;
            border-color: #f05a46;

            HorizontalLayout {
                padding: 18px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "Monitor Manager v1.14";
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Dark Matte Titanium & Acrylic · Motore Nativo Slint (~2-8 MB RAM in Tray)";
                        color: #c5cbd6;
                        font-size: 12px;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 12px;
            background: #21252e;
            border-width: 1px;
            border-color: #2d323e;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                alignment: space-between;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Crea collegamento sul Desktop";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-desktop; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Crea collegamento nel Menu Start";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-start-menu; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Avvia automaticamente con Windows (in System Tray)";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-autostart; }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Avvia Monitor Manager al termine";
                        color: #e9edf5;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    TitaniumToggle { checked <=> root.opt-launch; }
                }

                Text {
                    text: root.status-text;
                    color: root.installed ? #39d353 : #9da5b4;
                    font-size: 12px;
                    font-weight: 600;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            if !root.installed : Rectangle {
                width: 190px;
                height: 40px;
                border-radius: 8px;
                background: root.installing ? #454b59 : #f05a46;
                Text {
                    text: root.installing ? "Installazione..." : "Installa v1.14 Ora";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    enabled: !root.installing;
                    mouse-cursor: pointer;
                    clicked => { root.start-install(); }
                }
            }
            if root.installed : Rectangle {
                width: 190px;
                height: 40px;
                border-radius: 8px;
                background: #39d353;
                Text {
                    text: "Completa e Avvia";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.finish-setup(); }
                }
            }
        }
    }
    }
}
