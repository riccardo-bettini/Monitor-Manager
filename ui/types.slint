export struct UiVcpOption {
    value: int,
    label: string,
}

export struct UiDiscoveredVcp {
    code: int,
    hex-code: string,
    name-it: string,
    name-en: string,
    category: string,
    is-continuous: bool,
    current: int,
    max: int,
    is-read-only: bool,
    is-critical: bool,
    options: [UiVcpOption],
}

export struct UiMonitor {
    id: int,
    name: string,
    brand: string,
    resolution: string,
    is-primary: bool,
    ddc-supported: bool,
    is-internal-wmi: bool,
    brightness: int,
    brightness-max: int,
    brightness-sup: bool,
    contrast: int,
    contrast-max: int,
    contrast-sup: bool,
    sharpness: int,
    sharpness-max: int,
    sharpness-sup: bool,
    saturation: int,
    saturation-max: int,
    saturation-sup: bool,
    red-gain: int,
    green-gain: int,
    blue-gain: int,
    rgb-sup: bool,
    color-temp: int,
    color-temp-sup: bool,
    volume: int,
    volume-sup: bool,
    input-source: int,
    input-sup: bool,
    current-hz: int,
    available-hz: [int],
    hdr-supported: bool,
    hdr-enabled: bool,
    mccs-version: string,
    vcps-probing: bool,
    discovered-vcps: [UiDiscoveredVcp],
    sw-lut-enabled: bool,
    sw-gamma: int,
    sw-warmth: int,
    sw-contrast: int,
    sw-red: int,
    sw-green: int,
    sw-blue: int,
    // ASUS DisplayWidget Center parity fields
    is-asus: bool,
    is-oled: bool,
    dual-mode-sup: bool,
    gamevisual-sup: bool,
    gamevisual-mode: int,
    variable-od: int,
    variable-od-max: int,
    variable-od-sup: bool,
    blue-light: int,
    blue-light-max: int,
    blue-light-sup: bool,
    vivid-pixel: int,
    vivid-pixel-max: int,
    vivid-pixel-sup: bool,
    elmb: int,
    elmb-max: int,
    elmb-sup: bool,
    oled-flicker: int,
    oled-flicker-max: int,
    shadow-boost: int,
    shadow-boost-max: int,
    shadow-boost-sup: bool,
    dynamic-shadow-boost: bool,
    dynamic-shadow-boost-sup: bool,
    frame-rate-boost: bool,
    vrr-enabled: bool,
    vrr-sup: bool,
    aspect-control: int,
    aspect-control-sup: bool,
    color-space: int,
    color-space-sup: bool,
    crosshair-style: int,
    timer-preset: int,
    fps-counter: bool,
    alignment-grid: bool,
    caps-raw: string,
    mpu-ver: string,
}

export struct UiWindowEntry {
    hwnd-str: string,
    title: string,
    exe-name: string,
}

export struct UiHotkeyItem {
    id: int,
    action: string,
    label-it: string,
    label-en: string,
    shortcut: string,
    enabled: bool,
}

export struct UiAppRule {
    index: int,
    exe-name: string,
    display-name: string,
    gamevisual-mode: int,
    brightness: int,
    blue-light: int,
    variable-od: int,
    shadow-boost: int,
    enabled: bool,
}
